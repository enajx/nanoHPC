#!/usr/bin/python3
"""Forced command of the front node's login-copy key on a login node (root's authorized_keys, from the front node's
address only): receive the front node's monitoring snapshot and the users' home usage boxes for the login banner.

Allowed: the rsync server command line, as rsync 3.2 and 3.4 clients send it, writing only to FOLDER/status.json
or FOLDER/home-notices/ (FOLDER: /var/lib/nanohpc-login-copy), with short options from a fixed list and the long
options --numeric-ids, --delete (and rsync's --delete-before/during/after/delay forms) and --timeout=N. Words may hold only letters, digits and `._/=-`. Anything else
prints a message on stderr and exits 1; an allowed command is run directly (exec, no shell). Root receives, so each
usage box keeps its owner and stays private.
"""

import os
import re
import sys

FOLDER = "/var/lib/nanohpc-login-copy"
TARGETS = (FOLDER + "/status.json", FOLDER + "/home-notices/")
SAFE_COMMAND = re.compile(r"[A-Za-z0-9._/= -]+")
# One short option group: flags without arguments, then rsync's "e." capability letters.
SHORT_OPTIONS = re.compile(r"-[vqlogDtprcuWIxSdOJNU]*e\.[A-Za-z]*")
LONG_OPTIONS = re.compile(r"--(numeric-ids|delete|delete-before|delete-during|delete-after|delete-delay|timeout=[0-9]+)")


def refuse(reason: str) -> None:
    """Print why the command was refused and exit 1."""
    print("nanohpc-login-copy-receive: refused: " + reason, file=sys.stderr)
    sys.exit(1)


def allowed(command: str) -> list[str]:
    """Return the words of an allowed rsync server command line; refuse anything else."""
    if not SAFE_COMMAND.fullmatch(command):
        refuse("only an rsync server command with plain characters is allowed")
    words = command.split(" ")
    if words[:2] != ["rsync", "--server"] or "--sender" in words:
        refuse("only 'rsync --server' receiving is allowed")
    options = words[2:-2]
    if not options or not SHORT_OPTIONS.fullmatch(options[0]):
        refuse("the short rsync options are missing or not allowed")
    for option in options[1:]:
        if not LONG_OPTIONS.fullmatch(option):
            refuse("rsync option not allowed: " + option)
    if len(words) < 5 or words[-2] != "." or words[-1] not in TARGETS:
        refuse("the command must end with '. " + "' or '. ".join(TARGETS) + "'")
    return words


def main() -> None:
    """Check the client's command, then run it without a shell."""
    words = allowed(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
    os.execvp(words[0], words)


if __name__ == "__main__":
    main()
