{
  "uid": "nanohpc-history", "title": "Daily cluster history", "schemaVersion": 39,
  "editable": false, "refresh": "30s", "time": {"from": "now-5y", "to": "now"},
  "description": "One sample per day of rolling 24-hour summaries. Coverage shows partial days and collection gaps. GPU-hours are cumulative allocation totals, not usage during that day.",
  "panels": [
    {"id": 1, "title": "Allocated GPU-hours at daily sample", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "cluster-history"}, "targets": [{"refId": "A", "expr": "last_over_time(cluster_daily_allocated_gpu_hours_total[25h])", "legendFormat": "{{user}}"}]},
    {"id": 2, "title": "24-hour mean CPU usage", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "cluster-history"}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "targets": [{"refId": "A", "expr": "last_over_time(cluster_daily_cpu_busy_ratio[25h])", "legendFormat": "{{machine}}"}]},
    {"id": 3, "title": "24-hour mean GPU utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "cluster-history"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"refId": "A", "expr": "last_over_time(cluster_daily_gpu_utilization_percent[25h])", "legendFormat": "{{machine}} GPU {{gpu}}"}]},
    {"id": 4, "title": "Observed fraction of the 24-hour window", "description": "Measured on a one-minute grid. Less than 100% means a partial day or missing collection. Missing data is not zero load.", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "cluster-history"}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "targets": [{"refId": "A", "expr": "last_over_time(cluster_daily_scrape_coverage_ratio[25h])", "legendFormat": "{{machine}}"}]}
  ]
}
