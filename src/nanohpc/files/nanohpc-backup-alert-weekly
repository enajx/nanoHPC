#!/usr/bin/env python3
"""Remind Slack of backup alerts that remain active at the weekly check."""

import argparse
import json
from datetime import datetime
from pathlib import Path
from urllib.request import Request, urlopen

BACKUP_ALERTS = {"BackupFailed", "BackupOld"}


def active_backup_alerts(alertmanager: str) -> list[dict]:
    """Read active, unsuppressed backup alerts from Alertmanager."""
    with urlopen(f"{alertmanager.rstrip('/')}/api/v2/alerts", timeout=20) as response:
        alerts = json.loads(response.read().decode())
    if not isinstance(alerts, list):
        raise TypeError("Alertmanager did not return an alert list")
    return sorted(
        (
            alert
            for alert in alerts
            if alert["labels"].get("alertname") in BACKUP_ALERTS and alert["status"]["state"] == "active"
        ),
        key=lambda alert: (alert["labels"].get("machine", ""), alert["labels"]["alertname"]),
    )


def reminder(cluster: str, alerts: list[dict]) -> str:
    """Describe every backup problem with the day it first became active."""
    lines = [f"[{cluster}] Backup problems still active:"]
    for alert in alerts:
        started = datetime.fromisoformat(alert["startsAt"])
        summary = alert["annotations"]["summary"].strip()
        lines.append(f":red_circle: {summary} (since {started.day} {started:%b})")
    return "\n".join(lines)


def post(webhook_file: Path, body: str) -> None:
    """Send the reminder to the existing Slack webhook and require acceptance."""
    request = Request(
        webhook_file.read_text().strip(),
        data=json.dumps({"text": body}).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urlopen(request, timeout=20) as response:
        answer = response.read().decode().strip()
    if answer != "ok":
        raise RuntimeError(f"Slack webhook did not accept the reminder: {answer}")


def main() -> None:
    """Post one weekly reminder when at least one backup alert is active."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--alertmanager", required=True)
    parser.add_argument("--webhook-file", type=Path, required=True)
    parser.add_argument("--cluster", required=True)
    args = parser.parse_args()
    alerts = active_backup_alerts(args.alertmanager)
    if alerts:
        post(args.webhook_file, reminder(args.cluster, alerts))


if __name__ == "__main__":
    main()
