#!/usr/bin/env python3
"""Publish actual wall power from the machine's power-supply input sensors."""

import argparse
import math
import os
import re
import subprocess
import time
from pathlib import Path


def power_supplies() -> float:
    """Sum complete input readings without confusing output draw with wall draw."""
    response = subprocess.run(
        ["ipmitool", "sdr", "type", "Power Supply"],
        check=True,
        capture_output=True,
        text=True,
        timeout=15,
    )
    inputs: list[float] = []
    for line in response.stdout.splitlines():
        fields = [field.strip() for field in line.split("|")]
        if not re.fullmatch(r"PSU\d+ Power In", fields[0]):
            continue
        if len(fields) != 5:
            raise ValueError(f"Unreadable power supply input: {line}")
        reading = re.fullmatch(r"(\d+(?:\.\d+)?) Watts", fields[-1])
        if reading is None:
            raise ValueError(f"Unreadable power supply input: {line}")
        inputs.append(float(reading.group(1)))
    if not inputs:
        raise ValueError("The management chip reported no power supply input")
    watts = sum(inputs)
    if not math.isfinite(watts):
        raise ValueError(f"Invalid wall power: {watts}")
    return watts


def main() -> None:
    """Read all supplies, then atomically replace the node exporter textfile."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    watts = power_supplies()
    metrics = [
        "# TYPE cluster_wall_power_watts gauge",
        f'cluster_wall_power_watts{{source="power_supplies"}} {watts:.17g}',
        "# TYPE cluster_power_collection_timestamp_seconds gauge",
        f"cluster_power_collection_timestamp_seconds {time.time()}",
    ]
    temporary = args.output.with_name("." + args.output.name + ".tmp")
    with temporary.open("w", encoding="utf-8") as stream:
        stream.write("\n".join(metrics) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    temporary.chmod(0o644)
    temporary.replace(args.output)


if __name__ == "__main__":
    main()
