#!/usr/bin/env -S PYTHONCOERCECLOCALE=0 python3
"""Show the nanoHPC banner with a short animation, then your own cluster summary.

It animates only in an interactive UTF-8 terminal. Otherwise it prints the art once: plain ASCII
when the terminal is not UTF-8, and without colors when it is not a terminal. Colors follow the
time of day: warm by day, soft in the evening, matrix greens from midnight to 07:00.
PYTHONCOERCECLOCALE=0 keeps the terminal's own locale visible (a Mac sends LC_CTYPE=UTF-8).
"""

import json
import os
import pwd
import re
import shutil
import signal
import subprocess
import sys
import textwrap
import time
from collections.abc import Callable
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

# The cluster name and the website address (host and path), written by deploy.
SETTINGS = Path("/etc/nanohpc/login-banner.json")
SNAPSHOT = Path("/var/lib/nanohpc/monitor/status.json")
USAGE_DIR = Path("/var/lib/nanohpc-home-notices")
# Messages from cluster.yml: everyone.json, and users/<user>.json readable only by that user.
ANNOUNCEMENTS = Path("/var/lib/nanohpc/announcements")
# Warm yellow for the Announcements box.
ANNOUNCEMENT_TONE = 221
SQUEUE = "squeue"
LAST = "last"
# The same left margin for the art and the summary below it.
MARGIN = "  "
# 256-color palettes by time of day: warm by day, soft in the evening, matrix greens at night.
WARM = [209, 215, 216, 221, 220]
SOFT = [183, 147, 153, 189, 225]
MATRIX = [22, 28, 34, 40, 46]
UTC = timezone.utc  # noqa: UP017 (datetime.UTC needs Python 3.11; Ubuntu 22.04 has 3.10)
ESCAPE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
ART = [
    "                                 ██╗  ██╗██████╗  ██████╗",
    "                                 ██║  ██║██╔══██╗██╔════╝",
    "██████╗  ██████╗██████╗  █████╗  ███████║██████╔╝██║",
    "██╔══██╗██╔══██║██╔══██╗██╔══██╗ ██╔══██║██╔═══╝ ██║",
    "██║  ██║╚██████║██║  ██║╚█████╔╝ ██║  ██║██║     ╚██████╗",
    "╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝ ╚════╝  ╚═╝  ╚═╝╚═╝      ╚═════╝",
]
ASCII_ART = [
    "                           _   _ ____   ____",
    " _ __   __ _ _ __   ___   | | | |  _ \\ / ___|",
    "| '_ \\ / _` | '_ \\ / _ \\  | |_| | |_) | |",
    "| | | | (_| | | | | (_) | |  _  |  __/| |___",
    "|_| |_|\\__,_|_| |_|\\___/  |_| |_|_|    \\____|",
]


def utf8_terminal() -> bool:
    """Read the terminal's character set from the first locale setting that is set."""
    for name in ("LC_ALL", "LC_CTYPE", "LANG"):
        value = os.environ.get(name, "").lower()
        if value:
            return "utf-8" in value or "utf8" in value
    return False


def columns(reported: int) -> int:
    """Terminal width; Python 3.10 reports 0 for terminals without a size, so assume 80."""
    return reported if reported > 0 else 80


def palette(hour: int) -> list[int]:
    """Matrix greens from 00:00 to 07:00, warm colors until 18:00, soft colors until midnight."""
    return MATRIX if hour < 7 else WARM if hour < 18 else SOFT


def colored(line: str, width: int, offset: int, colors: list[int]) -> str:
    """Color a line in bands across the given width, shifted by offset for the wave."""
    band = max(1, -(-width // len(colors)))
    parts = [
        f"\033[1;38;5;{colors[(i // band + offset) % len(colors)]}m{line[i : i + band]}"
        for i in range(0, len(line), band)
    ]
    return "".join(parts) + "\033[0m"


def limited(command: list[str]) -> list[str]:
    """Cap a read at 2 seconds, so a slow Slurm or login history cannot hold up a login."""
    return ["timeout", "2", *command] if shutil.which("timeout") else command


def previous_login_seconds(user: str) -> float | None:
    """Seconds since the user's previous login (the session before this one), from the login history."""
    if not shutil.which(LAST):
        return None
    history = subprocess.run(
        limited([LAST, "-n", "2", "--time-format", "iso", user]), text=True, capture_output=True, check=False
    )
    sessions = [line.split() for line in history.stdout.splitlines() if line.split()[:1] == [user]]
    if history.returncode != 0 or len(sessions) < 2:
        return None
    return (datetime.now(UTC) - datetime.fromisoformat(sessions[1][3])).total_seconds()


def greeting(seconds: float | None, cluster: str) -> str:
    """A greeting for the time since the previous login; {} is the user's name."""
    if seconds is None:
        return f"Welcome to {cluster}, {{}}!"
    for limit, text in [
        (3600, "Hello again, {}!"),
        (86400, "Hello {}!"),
        (7 * 86400, "Welcome back, {}!"),
        (30 * 86400, "Long time no see, {}!"),
    ]:
        if seconds < limit:
            return text
    return "Look who's back! Hello {}!"


def box_tone(colors: list[int], waiting: bool) -> int:
    """A calm, non-bold tone for the home usage box: soft red when jobs wait, else one from the palette."""
    if waiting:
        return 174
    return {tuple(WARM): 216, tuple(SOFT): 189, tuple(MATRIX): 28}[tuple(colors)]


def value_tone(colors: list[int]) -> int:
    """A soft, non-bold tone for the summary's values: coral by day, lavender in the evening, green at night."""
    return {tuple(WARM): 210, tuple(SOFT): 183, tuple(MATRIX): 114}[tuple(colors)]


def medal(rank: int) -> str:
    """A gold, silver, or bronze medal for the top three; nothing below."""
    return {1: "🥇", 2: "🥈", 3: "🥉"}.get(rank, "")


def ordinal(number: int) -> str:
    """1st, 2nd, 3rd, 4th, 11th, 21st."""
    suffix = "th" if 10 <= number % 100 <= 20 else {1: "st", 2: "nd", 3: "rd"}.get(number % 10, "th")
    return f"{number}{suffix}"


def hours(value: float) -> str:
    """Whole hours from 10 up, one decimal below, and "<0.1" for a tiny amount above 0."""
    if 0 < value < 0.1:
        return "<0.1"
    return f"{value:.0f}" if value >= 10 else f"{value:.1f}"


def fresh_snapshot() -> dict | None:
    """The monitoring data, when it exists and is less than an hour old."""
    if not SNAPSHOT.is_file():
        return None
    data = json.loads(SNAPSHOT.read_text())
    if datetime.now(UTC) - datetime.fromisoformat(data["generated_at"]) > timedelta(hours=1):
        return None
    return data


def waiting(seconds: float | None) -> str:
    """A short waiting time: '30s' under a minute, '44m' under an hour, else hours with one decimal ('1.2h')."""
    if seconds is None:
        return "unknown"
    if seconds < 60:
        return f"{seconds:.0f}s"
    minutes = round(seconds / 60)
    return f"{minutes}m" if minutes < 60 else f"{seconds / 3600:.1f}h"


def jobs(count: int | str) -> str:
    """'1 job', '2 jobs', or 'unknown jobs'."""
    return "1 job" if count == 1 else f"{count} jobs"


def gpu_line(user: str, cluster: str, data: dict | None, value: Callable[[str], str], medals: bool) -> str:
    """GPU-hours and ranking from the monitoring data when it is fresh; medals need a UTF-8 terminal."""
    if data is None:
        return f"GPU-hours (last 30 days): {value('unknown')}"
    used = next((row["gpu_hours_30d"] for row in data["users"] if row["user"] == user), 0.0)
    ranked = [
        row["user"]
        for row in sorted(
            (row for row in data["users"] if row["gpu_hours_30d"] > 0),
            key=lambda row: (-row["gpu_hours_30d"], row["user"]),
        )
    ]
    rank = ranked.index(user) + 1 if user in ranked else None
    prize = f"{medal(rank)} " if rank is not None and medals and medal(rank) else ""
    ranking = f"{prize}{value(ordinal(rank))} in {cluster}" if rank is not None else value("none yet")
    return f"GPU-hours (last 30 days): {value(hours(used))}  |  Ranking: {ranking}"


def disk_lines(user: str, colors: list[int] | None) -> list[str]:
    """The user's latest home usage box in a calm tone, or why it is missing."""
    box = USAGE_DIR / user
    if box.is_file():
        plain = ESCAPE.sub("", box.read_text().strip("\n")).splitlines()
        if colors is None:
            return plain
        tone = box_tone(colors, any("New jobs wait" in line for line in plain))
        return [f"\033[38;5;{tone}m{line}\033[0m" for line in plain]
    if USAGE_DIR.is_dir():
        return ["Disk usage: not measured yet; it is measured every 5 minutes."]
    return ["Disk usage: run nanohpc-hello on the front node to see it."]


def shown_messages(path: Path, today: date) -> list[str]:
    """The messages in an announcements file whose dates include today (show_from and until are inclusive)."""
    if not path.is_file() or not os.access(path, os.R_OK):
        return []
    return [
        entry["message"]
        for entry in json.loads(path.read_text())
        if date.fromisoformat(entry["show_from"]) <= today <= date.fromisoformat(entry["until"])
    ]


def announcement_lines(user: str, data: dict | None, colors: list[int] | None, utf8: bool) -> list[str]:
    """The Announcements box: maintenance reservations, cluster messages, and the user's own messages; none
    without any."""

    def when(seconds: float) -> str:
        return datetime.fromtimestamp(seconds).strftime("%a %d %b %H:%M")  # noqa: DTZ006 (the front node's local time)

    # Only the start: a short reservation's end is not when the machine is back.
    items = [
        [
            f"From {when(window['start'])}: {', '.join(window['nodes'])}",
            *([f"  {window['comment']}"] if window["comment"] else []),
        ]
        for window in (data or {}).get("maintenance", [])
    ]
    today = datetime.now().date()  # noqa: DTZ005 (the front node's local day)
    items += [[message] for message in shown_messages(ANNOUNCEMENTS / "everyone.json", today)]
    items += [[message] for message in shown_messages(ANNOUNCEMENTS / "users" / f"{user}.json", today)]
    if not items:
        return []
    body = [
        wrapped
        for item in items
        for line in item
        for wrapped in textwrap.wrap(line, 70, subsequent_indent="  " if line.startswith("  ") else "")
    ]
    width = max(len(line) for line in body) + 2
    title = " Announcements "
    across, side, corners = ("─", "│", "┌┐└┘") if utf8 else ("-", "|", "++++")
    rows = [
        f"{corners[0]}{across}{title}{across * max(1, width - len(title) - 1)}{corners[1]}",
        *[f"{side} {line.ljust(max(width, len(title) + 2) - 2)} {side}" for line in body],
        f"{corners[2]}{across * max(width, len(title) + 2)}{corners[3]}",
    ]
    return [f"\033[38;5;{ANNOUNCEMENT_TONE}m{row}\033[0m" for row in rows] if colors else rows


def summary(user: str, colors: list[int] | None, utf8: bool) -> list[str]:
    """The lines below the art; values are colored only in a terminal (colors given)."""
    settings = json.loads(SETTINGS.read_text())
    cluster, website = settings["cluster_name"], settings["website"]
    name = colored(user, len(user), 0, colors) if colors else user
    states = (
        subprocess.run(limited([SQUEUE, "-h", "-u", user, "-o", "%T"]), text=True, capture_output=True, check=False)
        if shutil.which(SQUEUE)
        else None
    )
    running = states.stdout.split().count("RUNNING") if states is not None and states.returncode == 0 else "unknown"
    data = fresh_snapshot()
    everyone = jobs(data["running_jobs"]) if data else "unknown jobs"
    wait = waiting(data.get("average_wait_seconds_7d")) if data else "unknown"
    # Values with their units in the palette's soft, non-bold tone.
    value = (lambda text: f"\033[38;5;{value_tone(colors)}m{text}\033[0m") if colors else (lambda text: text)
    activity = (
        f"You are running {value(jobs(running))}  |  Cluster is running {value(everyone)}"
        f"  |  7d Waiting time: {value(wait)}"
    )
    label = (lambda text: f"\033[4m{text}\033[24m") if colors else (lambda text: text)
    box = announcement_lines(user, data, colors, utf8)
    return [
        greeting(previous_login_seconds(user), cluster).format(name),
        "",
        activity,
        gpu_line(user, cluster, data, value, utf8),
        "",
        *disk_lines(user, colors),
        "",
        f"{label('Cluster status')}: {website}#overview",
        f"{label('Cluster guide')}: {website}#docs | {website}docs.md",
        "",
        *([*box, ""] if box else []),
    ]


def restore(signum: int, frame: object) -> None:
    """Ctrl+C or the login's time cap: reset colors, show the cursor, and stop."""
    # Write straight to the terminal: the animation may be in the middle of a buffered write.
    os.write(sys.stdout.fileno(), b"\033[0m\033[?25h\n")
    os._exit(130)


def animate(art: list[str], colors: list[int]) -> None:
    """Reveal the art left to right, run a color wave over it, and settle on the static gradient."""
    out = sys.stdout
    width = max(len(line) for line in art)
    out.write("\033[?25l" + "\n" * len(art))
    frames = [(shown, 0) for shown in range(0, width + 4, 4)] + [(width, offset) for offset in range(1, 17)]
    frames.append((width, 0))
    for index, (shown, offset) in enumerate(frames):
        out.write(f"\033[{len(art)}A")
        for line in art:
            out.write("\r" + MARGIN + colored(line[:shown], width, offset, colors) + "\033[K\n")
        out.flush()
        if index < len(frames) - 1:
            time.sleep(0.06 if offset == 0 else 0.08)
    out.write("\033[0m\033[?25h")


def main() -> None:
    """Pick the richest output the terminal can show, then print the summary."""
    # From the very start: Ctrl+C, or the login's 10-second cap (SIGTERM), exits cleanly.
    signal.signal(signal.SIGINT, restore)
    signal.signal(signal.SIGTERM, restore)
    sys.stdout.reconfigure(encoding="utf-8")
    utf8 = utf8_terminal()
    terminal = sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb"
    art = ART if utf8 else ASCII_ART
    width = max(len(line) for line in art)
    # The user's local hour when they set TZ, otherwise the front node's.
    colors = palette(time.localtime().tm_hour)
    user = pwd.getpwuid(os.getuid()).pw_name
    # The summary's reads (squeue, the login history, the snapshot) run while the art animates, so the
    # lines below the art follow it without a pause.
    reader = ThreadPoolExecutor(max_workers=1)
    lines = reader.submit(summary, user, colors if terminal else None, utf8)
    print()
    if terminal and utf8 and columns(shutil.get_terminal_size().columns) >= width + 2:
        animate(art, colors)
    elif terminal:
        print("\n".join(MARGIN + colored(line, width, 0, colors) for line in art))
    else:
        print("\n".join(MARGIN + line for line in art))
    print()
    print("\n".join((MARGIN + line) if line else "" for line in lines.result()))
    sys.stdout.flush()


if __name__ == "__main__":
    main()
