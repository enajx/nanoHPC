def path_args(args: list[str]) -> list[str]:
    """Every argument, and the part after = of an option, that could name a file."""
    found = []
    for arg in args:
        for part in (arg, arg.split("=", 1)[1] if "=" in arg else ""):
            if part and ("/" in part or part.startswith(".") or SECRET_NAME.match(part)):
                found.append(part)
    return found


def absolute(path: str) -> str:
    """The path as the runner reads it: commands run from /, so a relative path starts there."""
    return os.path.normpath(os.path.join(os.sep, path))


def under(path: str, folders: tuple[str, ...]) -> bool:
    """True when the (absolute, normalised) path is one of the folders or under one."""
    return any(path == folder or path.startswith(folder + os.sep) for folder in folders)


def secret_place(path: str) -> bool:
    """True for a file that holds a secret: its folder, the file itself, its name, or a process's memory or
    environment (an absolute, normalised path)."""
    if path == "/dev/null":
        return False
    if under(path, SECRET_DIRS) or path in SECRET_FILES or re.fullmatch(r"/proc/[^/]+/(environ|mem)", path):
        return True
    name = os.path.basename(path)
    return bool(SECRET_NAME.match(name)) and not name.endswith(".pub")


def path_refusal(paths: list[str], reals: list[str], approved: bool) -> str | None:
    """Why these paths (as written, absolute) and their real paths (links followed, on the machine the command runs
    on) are refused, or None."""
    for path, real in zip(paths, reals, strict=True):
        if secret_place(path) or secret_place(real):
            return f"{path} holds secrets and is never read or changed from Slack"
    for path, real in zip(paths, reals, strict=True):
        if (under(path, PRIVATE_DIRS) or under(real, PRIVATE_DIRS)) and not approved:
            return f"{path} is in people's own files or a place anyone can write to; read only when an approver asks"
    return None


def local_paths(argv: list[str]) -> tuple[list[str], list[str]]:
    """The command's paths, absolute, and their real paths on this machine."""
    paths = [absolute(path) for path in path_args(argv[1:])]
    return paths, [os.path.realpath(path) for path in paths]


PING_VALUE = {"-c", "-W"}
PING_MAX_COUNT = 10


def ping_refusal(args: list[str]) -> str | None:
    """ping needs a count (-c, at most PING_MAX_COUNT) and one host; only -c, -W, and -q."""
    hosts: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in PING_VALUE:
            if index + 1 >= len(args) or not args[index + 1].isdigit():
                return f"{arg} needs a number"
            index += 2
            continue
        if arg == "-q":
            index += 1
            continue
        if arg.startswith("-"):
            return f"ping {arg} is not allowed"
        hosts.append(arg)
        index += 1
    if "-c" not in args or int(args[args.index("-c") + 1]) > PING_MAX_COUNT:
        return f"ping needs -c with a count of at most {PING_MAX_COUNT}"
    if len(hosts) != 1:
        return "ping takes one host"
    return None


def git_refusal(args: list[str]) -> str | None:
    """git only reads: optional -C folder, then a reading subcommand, with no config or output options."""
    rest = args[2:] if args[:1] == ["-C"] and len(args) >= 2 else args
    if not rest or rest[0] not in GIT_READS:
        return f"git {rest[0] if rest else ''} is not a reading git command (allowed: {', '.join(sorted(GIT_READS))})"
    if any(arg.startswith(("-c", "--output", "--ext-diff", "--textconv", "--exec", "--upload-pack", "--config", "-O",
                           "--open-files-in-pager")) for arg in rest):  # fmt: skip
        return "that git option can run a program or write a file"
    if "--no-index" in rest:
        return "git --no-index reads outside a repository (a recursive read)"
    if rest[0] in ("branch", "tag", "remote") and any(
        not arg.startswith("-") or arg.split("=", 1)[0] not in GIT_LISTING_OPTIONS for arg in rest[1:]
    ):
        return f"git {rest[0]} only lists here"
    if rest[0] == "reflog" and {"expire", "delete", "drop"} & set(rest[1:]):
        return "git reflog only shows here"
    return None


def uses_option(args: list[str], options: tuple[str, ...]) -> str | None:
    """The first argument that uses one of these options (also as --option=value, shortened as programs accept it
    (--rec for --recursive), or a one-letter option inside a group like -abc), or None."""
    for arg in args:
        name = arg.split("=", 1)[0]
        for option in options:
            if arg == option or (
                option.startswith("--") and name.startswith("--") and len(name) > 2 and option.startswith(name)
            ):
                return arg
            if len(option) == 2 and arg.startswith("-") and not arg.startswith("--") and option[1] in arg[1:]:
                return arg
    return None


def subcommand_refusal(program: str, args: list[str]) -> str | None:
    """Programs with subcommands: a reading one (the first plain word), and no option that reaches elsewhere."""
    reads, bare, never = SUBCOMMANDS[program]
    option = uses_option(args, never)
    if option is not None:
        return f"{program} {option} is not allowed here"
    words = [arg for arg in args if not arg.startswith("-")]
    if not words:
        return None if bare else f"{program} needs one of: {', '.join(sorted(reads))}"
    if words[0] not in reads:
        return (f"{program} {words[0]} is not a reading {program} command (allowed: {', '.join(sorted(reads))}; "
                "give option values with =)")
    if program == "chronyc" and len(words) != 1:
        return "chronyc takes one command"
    if program == "nft" and (NFT_WRITES & set(words) or any(mark in arg for arg in args for mark in ";{}\n")):
        return "that nft command changes the rules"
    return None


def iptables_refusal(args: list[str]) -> str | None:
    """iptables only lists: -S, -L, -n, -v, -x (also grouped), -t TABLE, and listing long options."""
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in ("-t", "--table"):
            index += 2
            continue
        if arg.startswith("--") and arg not in IPTABLES_LONG:
            return f"iptables {arg} is not a listing option"
        if arg.startswith("-") and not arg.startswith("--") and not set(arg[1:]) <= IPTABLES_LETTERS:
            return f"iptables {arg} is not a listing option"
        if not arg.startswith("-") and not re.fullmatch(r"[A-Za-z0-9_-]+", arg):
            return f"iptables {arg} is not a chain name"
        index += 1
    return None


def ipmitool_refusal(args: list[str]) -> str | None:
    """ipmitool reads the local BMC only: a reading command, no options but -c, and no word that writes."""
    if any(arg.startswith("-") and arg != "-c" for arg in args):
        return "ipmitool takes no options here but -c (it reads the local BMC only)"
    words = [arg for arg in args if arg != "-c"]
    if not any(words[: len(read)] == read for read in IPMI_READS) or IPMI_WRITES & set(words):
        return f"ipmitool {' '.join(words[:2])} is not a reading ipmitool command"
    return None


def recursive(program: str, args: list[str]) -> bool:
    """True for a grep or diff that walks folders (refused: it could reach files with secrets)."""
    if program not in ("grep", "zgrep", "diff"):
        return False
    options = ("--recursive", "--dereference-recursive", "--directories", "-r", "-R")
    # grep's -d takes recurse as its value (also in a group: -nd recurse); diff's -d is something else.
    return uses_option(args, options + (("-d",) if program != "diff" else ())) is not None


def command_refusal(argv: list[str], slurm: bool) -> str | None:
    """Why the runner refuses this command as a read, from its program and arguments alone, or None."""
    if not argv:
        return "empty command"
    program, args = argv[0], argv[1:]
    if any("\n" in arg for arg in argv):
        return "arguments may not hold line breaks"
    if program in SLURM_READ_ONLY and not slurm:
        return f"{program} is not on the read-only list (this cluster has no Slurm)"
    if program in SUBCOMMANDS:
        return subcommand_refusal(program, args)
    if program not in READ_ONLY and program not in SLURM_READ_ONLY:
        return f"{program} is not on the read-only list"
    if recursive(program, args):
        return f"a recursive {program} is not allowed (it could reach files with secrets); name the files"
    option = uses_option(args, CHANGING_OPTIONS.get(program, ()))
    if option is not None:
        return f"{program} {option} changes something"
    if program == "ping":
        return ping_refusal(args)
    if program == "hostname":
        return None if not args else "hostname takes no arguments here"
    if program == "git":
        return git_refusal(args)
    if program == "iptables":
        return iptables_refusal(args)
    if program == "ipmitool":
        return ipmitool_refusal(args)
    if program == "dpkg" and (args[:1] not in (["-l"], ["-s"], ["-L"], ["--list"], ["--status"], ["--listfiles"])
                              or any(arg.startswith("-") for arg in args[1:])):  # fmt: skip
        return "dpkg only lists here: -l, -s, or -L, then package names"
    if program == "date" and any(not arg.startswith(("-", "+")) for arg in args):
        return "date with a plain argument sets the clock"
    if program == "tail" and any(arg in ("-f", "-F") or arg.startswith("--follow") for arg in args):
        return "tail -f never ends; use tail -n"
    if program == "find" and any(arg in FIND_ACTIONS for arg in args):
        return "that find action runs a program or writes a file"
    if program == "nvidia-smi" and any(arg.split("=", 1)[0] in NVIDIA_CHANGES for arg in args):
        return "that nvidia-smi option changes the GPUs or never ends"
    # BSD-style letters without a dash: "e" adds the environment ("-e" with a dash only means all processes).
    if program == "ps" and any(not arg.startswith("-") and arg.isalpha() and "e" in arg for arg in args):
        return "ps e shows processes' environment, which can hold keys"
    if program == "ip" and IP_CHANGES & set(args):
        return "that ip command changes the network or runs a program"
    if program == "top" and ("-b" not in args or "-n" not in args):
        return "top needs -b -n 1"
    if program in ("cat", "head", "tail", "zcat") and not [arg for arg in args if not arg.startswith("-")]:
        return f"{program} needs a file"
    return None


def refusal(argv: list[str], slurm: bool) -> str | None:
    """Why the runner refuses this command as a read on this machine (as anyone but an approver), or None."""
    reason = command_refusal(argv, slurm)
    if reason is not None:
        return reason
    paths, reals = local_paths(argv)
    return path_refusal(paths, reals, False)


# On the front node, a change may not touch the agent's own files, account or services (its rules and limits
# live there), nor use a program that runs outside the runner's service limits. The service also mounts those
# files read-only for the runner.
OWN_MARK = "nanohpc-agent"
LEAVES_LIMITS = {"systemd-run", "nsenter", "unshare", "mount", "umount", "chroot", "machinectl", "systemd-nspawn"}
# The deploys the agent may ask for: `nanohpc deploy`, its dry run, or one part.
DEPLOY_PARTS = {"users", "policy", "partitions", "node"}


def deploy_refusal(args: list[str], slurm: bool) -> str | None:
    """Why these `nanohpc deploy` arguments are refused, or None: none, --dry-run, or --only with one part (in
    monitor mode, deploy-monitor's only part: node NAME)."""
    if args in ([], ["--dry-run"]):
        return None
    if not slurm and args[:2] != ["--only", "node"]:
        return "in monitor mode, nanohpc deploy takes nothing, --dry-run, or --only node NAME"
    if len(args) >= 2 and args[0] == "--only" and args[1] in DEPLOY_PARTS:
        if args[1] == "node":
            return None if len(args) == 3 and re.fullmatch(r"[a-zA-Z][a-zA-Z0-9_-]*", args[2]) else "--only node takes one machine name"
        return None if len(args) == 2 else f"--only {args[1]} takes nothing after it"
    return "nanohpc deploy takes nothing, --dry-run, or --only users | policy | partitions | node NAME"


class RunnerRule:
    """What the runner may run: read-only commands for anyone; any other command (a change) only when asked as a
    change by an approver or with an approver's click. Commands for another machine go there as root over SSH
    with the runner's own key; the front node's are run here."""

    def __init__(self, front: str, approvers: list[str], hosts: dict[str, str], key: str, known_hosts: str,
                 slurm: bool) -> None:
        self.front, self.approvers, self.hosts = front, approvers, hosts
        self.key, self.known_hosts, self.slurm = key, known_hosts, slurm

    def refusal(self, argv: list[str], requester: str, host: str, mode: str, approver: str | None) -> str | None:
        """Why this request is refused, or None."""
        if host != self.front and host not in self.hosts:
            return f"refused: unknown machine {host}; known: {', '.join([self.front, *sorted(self.hosts)])}."
        if not argv:
            return "refused: empty command."
        approved = requester in self.approvers or approver in self.approvers
        paths = [absolute(path) for path in path_args(argv[1:])]
        reals = self.real_paths(paths, host)
        if reals is None:
            return f"refused: could not check where the paths lead on {host}."
        # Files with secrets are refused for everyone, also as a change.
        reason = path_refusal(paths, reals, True)
        if reason is not None:
            return f"refused: {reason}."
        reason = command_refusal(argv, self.slurm)
        if reason is None:
            private = path_refusal(paths, reals, approved)
            return None if private is None else f"refused: {private}."
        if mode != "change":
            return (f"refused: {reason}. This is not a read the runner allows; asked by an approver, the deep agent "
                    "can run it as a change.")
        if host == self.front and Path(argv[0]).name in LEAVES_LIMITS:
            return f"refused: {argv[0]} could run outside the runner's limits on {self.front}."
        if host == self.front and any(OWN_MARK in arg for arg in argv):
            return f"refused: on {self.front}, changes may not touch the agent's own files, account, or services."
        if approved:
            return None
        return "refused: a change runs only for an approver, or after an approver clicks Approve."

    def ssh(self, host: str, command: str) -> list[str]:
        """ssh to another machine as root with the runner's key, running `command` there."""
        return [
            "ssh", "-i", self.key, "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
            "-o", f"UserKnownHostsFile={self.known_hosts}", "-o", "StrictHostKeyChecking=yes",
            "-o", "ConnectTimeout=10", f"root@{self.hosts[host]}", "--", command,
        ]  # fmt: skip

    def real_paths(self, paths: list[str], host: str) -> list[str] | None:
        """Where these absolute paths really lead (links followed) on the machine the command runs on; None when
        that cannot be read."""
        if not paths:
            return []
        if host == self.front:
            return [os.path.realpath(path) for path in paths]
        result = subprocess.run(self.ssh(host, f"realpath -m -- {shlex.join(paths)}"), capture_output=True, text=True,
                                timeout=COMMAND_TIMEOUT, stdin=subprocess.DEVNULL, check=False)
        reals = result.stdout.splitlines()
        if result.returncode != 0 or len(reals) != len(paths):
            return None
        return [os.path.normpath(real) for real in reals]

    def command(self, argv: list[str], host: str) -> list[str]:
        """The argv to run: the command itself on the front node (from /), ssh for another machine (also from /)."""
        if argv[0] == "git":
            # No pager, hooks, or fsmonitor; git itself refuses repositories not owned by root.
            argv = ["git", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "--no-pager", *argv[1:]]
        if host == self.front:
            return argv
        return self.ssh(host, f"cd / && {shlex.join(argv)}")

    def run(self, argv: list[str], requester: str, host: str, mode: str, approver: str | None) -> tuple[bool, str]:
        """Run the request if the rule allows it; return whether it ran and its masked output."""
        reason = self.refusal(argv, requester, host, mode, approver)
        if reason is not None:
            return False, reason
        command = self.command(argv, host)
        if shutil.which(command[0]) is None:
            return False, f"{command[0]} is not installed on this machine."
        # A command that runs too long is reported to Claude, not left to crash the request.
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
                                    stdin=subprocess.DEVNULL, cwd="/", check=False)
        except subprocess.TimeoutExpired:
            return True, f"[stopped after {COMMAND_TIMEOUT} seconds: the command took too long]"
        output = result.stdout + result.stderr
        if len(output) > OUTPUT_LIMIT:
            output = output[:OUTPUT_LIMIT] + f"\n[cut: {len(output) - OUTPUT_LIMIT} more characters]"
        return True, mask(f"{output}\n[exit {result.returncode}]")


def git_ssh(key: str, known_hosts: str) -> str:
    """The ssh command git uses with the agent's repository key and the repository host's pinned key."""
    return (f"ssh -i {shlex.quote(key)} -o IdentitiesOnly=yes -o BatchMode=yes "
            f"-o UserKnownHostsFile={shlex.quote(known_hosts)} -o StrictHostKeyChecking=yes")


class CodeChanges:
    """Code changes from Slack: edits to the cluster.yml repository. The runner keeps its own clone, which only
    root can reach, and the repository key. The agent edits a plain copy in its own folder; the runner turns that
    into a patch, run as the agent's account, and applies it to its clone with git apply (which refuses paths
    outside the repository). A commit and push happen only after an approver's click, and only for the exact tree
    that was shown."""

    def __init__(self, remote: str, branch: str, clone: str, work: str, agent_user: str, key: str, known_hosts: str,
                 approvers: list[str], author: str, email: str, after_push: str) -> None:
        self.remote, self.branch, self.clone, self.work, self.approvers = remote, branch, clone, work, approvers
        self.author, self.email, self.after_push = author, email, after_push
        # As the agent's account, so root never writes into or reads through the agent's folder.
        same = agent_user == os.environ.get("USER", "") or agent_user == ""
        self.as_agent = [] if same else ["runuser", "-u", agent_user, "--"]
        self.ssh = git_ssh(key, known_hosts)

    def git(self, *args: str, stdin: str | None) -> subprocess.CompletedProcess:
        """git as root in the runner's clone, with hooks off."""
        return subprocess.run(
            ["git", "-c", "core.hooksPath=/dev/null", "-c", f"safe.directory={self.clone}", "-C", self.clone, *args],
            input=stdin, capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
            env=dict(os.environ, GIT_SSH_COMMAND=self.ssh), check=False,
        )  # fmt: skip

    def agent(self, *argv: str, stdin: bytes | None) -> subprocess.CompletedProcess:
        """A command as the agent's account."""
        return subprocess.run([*self.as_agent, *argv], input=stdin, capture_output=True, timeout=COMMAND_TIMEOUT,
                              check=False)

    def fresh(self) -> str | None:
        """Clone if needed, then reset the clone to the branch on the remote with no other files; return an error,
        or None."""
        if not os.path.isdir(os.path.join(self.clone, ".git")):
            result = subprocess.run(["git", "clone", "-q", "-b", self.branch, self.remote, self.clone],
                                    capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
                                    env=dict(os.environ, GIT_SSH_COMMAND=self.ssh), check=False)
            if result.returncode != 0:
                return result.stderr
        for args in (("fetch", "-q", "origin", self.branch), ("reset", "-q", "--hard", f"origin/{self.branch}"),
                     ("clean", "-qfdx")):
            result = self.git(*args, stdin=None)
            if result.returncode != 0:
                return result.stderr
        return None

    def start(self) -> dict:
        """Give the agent a fresh copy of the branch in its folder."""
        error = self.fresh()
        if error is not None:
            return {"ok": False, "output": mask(error)}
        archive = subprocess.run(["git", "-c", f"safe.directory={self.clone}", "-C", self.clone, "archive",
                                  "--format=tar", "HEAD"], capture_output=True, timeout=COMMAND_TIMEOUT, check=False)
        steps = [
            (["find", self.work, "-mindepth", "1", "-delete"], None),
            (["tar", "-x", "-C", self.work], archive.stdout),
            (["git", "-C", self.work, "init", "-q"], None),
            (["git", "-C", self.work, "add", "-A"], None),
            (["git", "-C", self.work, "-c", "user.name=base", "-c", "user.email=base@localhost", "commit", "-qm",
              "base"], None),
        ]
        for argv, stdin in steps:
            result = self.agent(*argv, stdin=stdin)
            if result.returncode != 0:
                return {"ok": False, "output": result.stderr.decode()}
        head = self.git("rev-parse", "--short", "HEAD", stdin=None).stdout.strip()
        return {"ok": True, "output": f"{self.work} holds {self.branch} at {head}."}

    def stage(self) -> dict:
        """Apply the agent's edits to the clone (not committed); return the diff and its tree."""
        result = self.agent("git", "-C", self.work, "add", "-A", stdin=None)
        if result.returncode != 0:
            return {"ok": False, "output": result.stderr.decode()}
        patch = self.agent("git", "-C", self.work, "diff", "--cached", "--binary", "HEAD", stdin=None)
        error = self.fresh()
        if error is not None:
            return {"ok": False, "output": mask(error)}
        if not patch.stdout.strip():
            return {"ok": False, "output": "There are no changes in the work folder."}
        applied = self.git("apply", "--index", "--binary", "-", stdin=patch.stdout.decode())
        if applied.returncode != 0:
            return {"ok": False, "output": applied.stderr}
        tree = self.git("write-tree", stdin=None).stdout.strip()
        stat = self.git("diff", "--cached", "--stat", stdin=None).stdout
        diff = self.git("diff", "--cached", stdin=None).stdout
        return {"ok": True, "tree": tree, "stat": stat, "diff": mask(diff), "output": stat}

    def push(self, requester: str, approver: str | None, tree: str, message: str) -> dict:
        """Commit and push the staged change, only with an approver's click and only if it is what was shown."""
        if approver not in self.approvers:
            return {"ok": False, "output": "refused: a push needs a click on Approve by an approver."}
        if self.git("write-tree", stdin=None).stdout.strip() != tree:
            return {"ok": False, "output": "refused: the staged change is not the one that was shown. Ask again."}
        full = f"{message.strip()}\n\nRequested-by: {requester}\nApproved-by: {approver}\n"
        commit = self.git("-c", f"user.name={self.author}", "-c", f"user.email={self.email}", "commit", "-q", "-F",
                          "-", stdin=full)
        if commit.returncode != 0:
            return {"ok": False, "output": commit.stderr}
        pushed = self.git("push", "-q", "origin", f"HEAD:{self.branch}", stdin=None)
        if pushed.returncode != 0:
            self.fresh()
            return {"ok": False, "output": f"The push failed, nothing changed in the repository:\n{mask(pushed.stderr)}"}
        head = self.git("rev-parse", "--short", "HEAD", stdin=None).stdout.strip()
        return {"ok": True, "output": f"Pushed {head} to {self.branch}. {self.after_push}"}


class Deploys:
    """Deploys from Slack, asked as a change `nanohpc deploy [--dry-run | --only PART]` on the front node. The
    runner runs the given deploy command (nanoHPC's automatic deploy, which takes the same locks as every other
    deploy and runs `nanohpc deploy` with its dry run first on every machine) for the newest commit of the
    branch, also when that commit was deployed or failed before."""

    def __init__(self, argv: list[str]) -> None:
        """argv: the deploy command; the `nanohpc deploy` arguments follow it after `--`."""
        self.argv = argv

    def run(self, args: list[str]) -> tuple[bool, str]:
        """Run the deploy with these `nanohpc deploy` arguments; return whether it ran and its masked output."""
        try:
            result = subprocess.run([*self.argv, "--", *args], capture_output=True, text=True, timeout=DEPLOY_TIMEOUT,
                                    stdin=subprocess.DEVNULL, check=False)
        except subprocess.TimeoutExpired:
            return True, f"[stopped waiting after {DEPLOY_TIMEOUT // 60} minutes; the deploy may still be running]"
        output = result.stdout + result.stderr
        if len(output) > OUTPUT_LIMIT:
            output = output[-OUTPUT_LIMIT:] + f"\n[cut: the first {len(output) - OUTPUT_LIMIT} characters]"
        return True, mask(f"{output}\n[exit {result.returncode}]")


def serve_runner(socket_path: str, socket_group: str, log_path: Path, rule: RunnerRule, code: CodeChanges | None,
                 deploys: Deploys | None) -> None:
    """Answer one JSON request per connection: {argv, requester, host, mode, approver} -> {ran, output}, or a code
    request {code: start | stage | push, requester, approver, tree, message} -> CodeChanges' answer."""
    log_lock = threading.Lock()
    code_lock = threading.Lock()

    class Handler(socketserver.StreamRequestHandler):
        def handle(self) -> None:
            request = json.loads(self.rfile.readline())
            if "code" in request:
                action, requester = str(request["code"]), str(request["requester"])
                approver = None if request.get("approver") is None else str(request["approver"])
                with code_lock:
                    if code is None:
                        answer = {"ok": False, "output": "Code changes are off: the cluster has no repository."}
                    elif action == "start":
                        answer = code.start()
                    elif action == "stage":
                        answer = code.stage()
                    elif action == "push":
                        answer = code.push(requester, approver, str(request["tree"]), str(request["message"]))
                    else:
                        answer = {"ok": False, "output": f"unknown code request {action}"}
                record = {"time": datetime.now().astimezone().isoformat(), "requester": requester, "code": action,
                          "approver": approver, "ok": answer["ok"], "tree": answer.get("tree", request.get("tree"))}
                with log_lock, log_path.open("a") as log:
                    log.write(json.dumps(record) + "\n")
                self.wfile.write((json.dumps(answer) + "\n").encode())
                return
            argv = [str(part) for part in request["argv"]]
            requester, host, mode = str(request["requester"]), str(request["host"]), str(request["mode"])
            approver = None if request["approver"] is None else str(request["approver"])
            if host == rule.front and argv[:2] == ["nanohpc", "deploy"]:
                reason = rule.refusal(argv, requester, host, mode, approver)
                if reason is None:
                    reason = deploy_refusal(argv[2:], rule.slurm)
                    reason = None if reason is None else f"refused: {reason}."
                if reason is None and deploys is None:
                    reason = "refused: deploys from Slack are off: the cluster has no automatic deploy."
                ran, output = (False, reason) if reason is not None else deploys.run(argv[2:])
            else:
                ran, output = rule.run(argv, requester, host, mode, approver)
            record = {"time": datetime.now().astimezone().isoformat(), "requester": requester, "host": host,
                      "mode": mode, "approver": approver, "argv": argv, "ran": ran}
            with log_lock, log_path.open("a") as log:
                log.write(json.dumps(record) + "\n")
            self.wfile.write((json.dumps({"ran": ran, "output": output}) + "\n").encode())

    if os.path.exists(socket_path):
        os.unlink(socket_path)
    with socketserver.ThreadingUnixStreamServer(socket_path, Handler) as server:
        # Only the socket and its folder belong to the bot's group; the runner itself stays root:root, so files a
        # change creates on the front node are not the bot's to edit.
        gid = grp.getgrnam(socket_group).gr_gid
        os.chown(os.path.dirname(os.path.abspath(socket_path)), -1, gid)
        os.chmod(os.path.dirname(os.path.abspath(socket_path)), 0o750)
        os.chown(socket_path, -1, gid)
        os.chmod(socket_path, 0o660)
        server.serve_forever()


def ask_code(socket_path: str, request: dict) -> dict:
    """Send one code request to the runner (start, stage, or push) and return its answer."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(socket_path)
        connection.sendall((json.dumps(request) + "\n").encode())
        reply = connection.makefile().readline()
    return json.loads(reply)


def ask_runner(socket_path: str, argv: list[str], requester: str, host: str, mode: str,
               approver: str | None) -> dict:
    """Send one command to the runner and return its answer {ran, output}. mode is "read" or "change"; approver
    is the Slack member who clicked Approve, if any."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(socket_path)
        request = {"argv": argv, "requester": requester, "host": host, "mode": mode, "approver": approver}
        connection.sendall((json.dumps(request) + "\n").encode())
        reply = connection.makefile().readline()
    return json.loads(reply)


