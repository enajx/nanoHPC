class Ledger:
    """Today's spending and requests per person, kept in a file so a restart does not reset them.

    limits: daily_usd (everyone together), request_usd (one request), requests_per_person,
    unlimited (Slack member IDs with no per-person limit; the daily cap still applies).
    zone: the time zone whose midnight starts a new day (None: the machine's own).
    """

    def __init__(self, path: Path, limits: dict, zone: ZoneInfo | None) -> None:
        self.path = path
        self.limits = limits
        self.zone = zone
        self.lock = threading.Lock()

    def _today(self, now: datetime) -> dict:
        day = now.astimezone(self.zone).date().isoformat()
        state = json.loads(self.path.read_text()) if self.path.exists() else {}
        if state.get("day") != day:
            state = {"day": day, "spent": 0.0, "requests": {}, "cap_noticed": False}
        return state

    def _save(self, state: dict) -> None:
        temporary = self.path.with_suffix(".tmp")
        temporary.write_text(json.dumps(state))
        temporary.replace(self.path)

    def refusal(self, user: str, now: datetime) -> str | None:
        """Why this person's request is refused now, or None."""
        with self.lock:
            state = self._today(now)
        if state["spent"] >= self.limits["daily_usd"]:
            return (f"The daily limit of ${self.limits['daily_usd']:.2f} for everyone together is reached. "
                    "I answer again after midnight.")
        if (user not in self.limits["unlimited"]
                and state["requests"].get(user, 0) >= self.limits["requests_per_person"]):
            return (f"You have used your {self.limits['requests_per_person']} requests for today (the limit). "
                    "Try again tomorrow.")
        return None

    def requests_today(self, user: str, now: datetime) -> int:
        """How many requests this person has made today."""
        with self.lock:
            state = self._today(now)
        return state["requests"].get(user, 0)

    def budget(self, now: datetime) -> float:
        """The most one request may spend now: the per-request limit or what is left of the day."""
        with self.lock:
            state = self._today(now)
        return max(0.0, min(self.limits["request_usd"], self.limits["daily_usd"] - state["spent"]))

    def record(self, user: str, cost: float, now: datetime) -> None:
        """Count one request and its cost."""
        with self.lock:
            state = self._today(now)
            state["spent"] += cost
            state["requests"][user] = state["requests"].get(user, 0) + 1
            self._save(state)

    def cap_notice_due(self, now: datetime) -> bool:
        """True once a day, the first time this is asked after the daily cap is reached."""
        with self.lock:
            state = self._today(now)
            if state["spent"] < self.limits["daily_usd"] or state["cap_noticed"]:
                return False
            state["cap_noticed"] = True
            self._save(state)
            return True


