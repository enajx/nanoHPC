# change(argv, host, reason, could_cut_access) -> what Claude is told (Approvals.ask for this request).
Change = Callable[[list[str], str, str, bool], str]
# push(message) -> what Claude is told (stage the work folder and show it for approval).
Push = Callable[[str], str]
# answer(prompt, budget, requester, post, status, change, push) -> (reply text, cost in USD); post(text) writes to
# the thread; status(doing) shows what is being checked in the thread's one status line.
Answer = Callable[[str, float, str, Callable[[str], None], Callable[[str], None], Change, Push], tuple[str, float]]

PRIVATE_CONTEXT = 10  # earlier messages of a private chat given as context


def handle_event(event: dict, config: dict, ledger: Ledger, client, answer: Answer, approvals: Approvals,
                 now: datetime) -> None:
    """Answer a mention in the agent's channel, or a private message from an approver (answered privately); send
    everything else one redirect to the channel."""
    if event.get("bot_id") or event.get("subtype") or not event.get("user"):
        return
    channel, user = event["channel"], event["user"]
    redirect = f"I only take requests in <#{config['channel']}>, so everyone can see them. Please ask there."
    private = event["type"] == "message" and event.get("channel_type") == "im"
    if private and user not in config["approvers"]:
        client.chat_postMessage(channel=channel, text=redirect)
        return
    if event["type"] == "message" and not private:
        return
    if not private and channel != config["channel"]:
        client.chat_postEphemeral(channel=channel, user=user, text=redirect)
        return
    # Every request is answered in its thread. A new message in a private chat also gets the chat's recent
    # messages, so a follow-up sent outside the thread still has its context.
    flat = private and "thread_ts" not in event
    thread = event.get("thread_ts", event["ts"])

    def post(text: str) -> None:
        client.chat_postMessage(channel=channel, thread_ts=thread, text=mask(text))

    reason = ledger.refusal(user, now)
    if reason is not None:
        post(reason)
        return
    history = ""
    earlier: list[dict] = []
    if flat:
        earlier = list(reversed(client.conversations_history(channel=channel, limit=PRIVATE_CONTEXT)["messages"]))
    elif "thread_ts" in event:
        earlier = client.conversations_replies(channel=channel, ts=thread)["messages"]
    if earlier:
        history = "\n".join(f"{message.get('user', message.get('bot_id', '?'))}: {message.get('text', '')}"
                            for message in earlier if message.get("ts") != event["ts"])
    name = config["users"].get(user, "a Slack member with no cluster account")
    number = ledger.requests_today(user, now) + 1
    place = "in a private message" if private else "in the agent's channel"
    prompt = (f"Request from Slack member {user} ({name}) {place}, their request {number} today:\n{event['text']}"
              + (f"\n\nEarlier messages in this {'chat' if flat else 'thread'}:\n{history}" if history else ""))

    # Approve messages wait until the reply is posted, so the reply never comes after the click.
    held: list[Callable[[], None]] = []
    # One status line per request, posted at the first check and edited after that.
    checked: list[str] = []
    status_ts: list[str] = []

    def status(doing: str) -> None:
        if doing not in checked:
            checked.append(doing)
        text = mask(f"_Checking {doing}…_")
        if status_ts:
            client.chat_update(channel=channel, ts=status_ts[0], text=text)
        else:
            status_ts.append(client.chat_postMessage(channel=channel, thread_ts=thread, text=text)["ts"])

    def change(argv: list[str], host: str, reason: str, risky: bool) -> str:
        return approvals.ask(argv, host, reason, risky, user, client, channel, thread, held)

    def push(message: str) -> str:
        staged = approvals.code({"code": "stage", "requester": user})
        if not staged["ok"]:
            post(mask(f"_Could not prepare the change:_ {staged['output']}"))
            return staged["output"]
        return approvals.ask_push(staged, message, user, client, channel, thread, held)

    try:
        reply, cost = answer(prompt, ledger.budget(now), user, post, status, change, push)
        ledger.record(user, cost, now)
        if status_ts:
            client.chat_update(channel=channel, ts=status_ts[0], text=mask(f"_Checked {', '.join(checked)}._"))
        post(reply)
    finally:
        # Posted even if the request failed, since Claude was told they are in the thread.
        for later in held:
            later()
    if ledger.cap_notice_due(now):
        client.chat_postMessage(channel=channel, text=(
            f"The daily limit of ${ledger.limits['daily_usd']:.2f} for the agent is reached. "
            "It answers again after midnight."))


