# run(argv, requester, host, mode, approver) -> {ran, output}: ask_runner with the socket filled in.
Run = Callable[[list[str], str, str, str, str | None], dict]
# code(request) -> answer: ask_code with the socket filled in.
Code = Callable[[dict], dict]
DIFF_SHOWN = 3500  # characters of a diff per Slack message
DIFF_MESSAGES = 4  # messages at most; a longer diff is cut and says so


class Approvals:
    """Changes asked for in Slack. An approver's change runs at once, unless it could cut remote access; any
    other change waits in the thread with Approve and Deny buttons, and only a click by an approver counts (Slack
    sets the clicker's member ID, and the runner checks it again). Waiting changes are kept in memory: after a
    restart, a click says the change has expired."""

    def __init__(self, approvers: dict[str, str], run: Run, code: Code) -> None:
        """approvers: Slack member ID -> name."""
        self.approvers, self.run, self.code = approvers, run, code
        self.waiting: dict[str, dict] = {}
        self.lock = threading.Lock()

    def names(self) -> str:
        return " or ".join(f"<@{member}>" for member in self.approvers)

    def post_result(self, client, channel: str, thread: str, argv: list[str], host: str, result: dict) -> None:
        client.chat_postMessage(channel=channel, thread_ts=thread, text=mask(result_line(argv, host, result)))

    def who(self, channel: str, requester: str) -> str:
        """Who a waiting request names: nobody in a private chat (ID starting with D), where the approvers are
        not; in a channel, the approvers and the requester."""
        if channel.startswith("D"):
            return "Waiting for Approve: you ask"
        return f"{' '.join(f'<@{member}>' for member in self.approvers)}: <@{requester}> asks"

    def post_buttons(self, client, channel: str, thread: str, text: str, kind: str, waiting: dict) -> None:
        """Keep a waiting request and post it with its Approve and Deny buttons."""
        key = uuid.uuid4().hex
        with self.lock:
            self.waiting[key] = {**waiting, "kind": kind, "channel": channel, "thread": thread}
        client.chat_postMessage(channel=channel, thread_ts=thread, text=text, blocks=[
            {"type": "section", "text": {"type": "mrkdwn", "text": text}},
            {"type": "actions", "elements": [
                {"type": "button", "action_id": f"{kind}_approve", "value": key, "style": "primary",
                 "text": {"type": "plain_text", "text": "Approve"}},
                {"type": "button", "action_id": f"{kind}_deny", "value": key, "style": "danger",
                 "text": {"type": "plain_text", "text": "Deny"}},
            ]},
        ])

    def ask(self, argv: list[str], host: str, reason: str, risky: bool, requester: str, client, channel: str,
            thread: str, held: list[Callable[[], None]]) -> str:
        """Run the change, or hold its Approve message in `held` (posted after the reply); return what Claude is
        told. A change that ran gets one plain line in the thread; a dry run (--dry-run) gets none."""
        if requester in self.approvers and not risky:
            result = self.run(argv, requester, host, "change", None)
            if "--dry-run" not in argv:
                self.post_result(client, channel, thread, argv, host, result)
            return result["output"]
        why = " It could cut remote access." if risky else ""
        text = mask(f"{self.who(channel, requester)} to run `{shlex.join(argv)}` on {host}.\n"
                    f"Reason: {reason}.{why}")
        held.append(lambda: self.post_buttons(client, channel, thread, text, "change",
                                              {"argv": argv, "host": host, "requester": requester}))
        return ("Not run yet. Its Approve and Deny buttons are posted in the thread right after your reply; it runs "
                "only after a click on Approve by an approver, and its result is then posted in the thread. Stop "
                "here and tell the person it waits for their Approve below.")

    def ask_push(self, staged: dict, message: str, requester: str, client, channel: str, thread: str,
                 held: list[Callable[[], None]]) -> str:
        """Hold a staged code change's diff and Approve message in `held` (posted after the reply); a push always
        waits for an approver's click, whoever asked."""
        diff = staged["diff"]
        parts = [diff[start : start + DIFF_SHOWN] for start in range(0, len(diff), DIFF_SHOWN)][:DIFF_MESSAGES]
        text = mask(f"{self.who(channel, requester)} to commit and push:\n```{message}\n\n{staged['stat']}```")

        def show() -> None:
            for part in parts:
                client.chat_postMessage(channel=channel, thread_ts=thread, text=f"```{part}```")
            if len(diff) > DIFF_SHOWN * DIFF_MESSAGES:
                client.chat_postMessage(channel=channel, thread_ts=thread, text=(
                    f"_The diff is cut: {len(diff) - DIFF_SHOWN * DIFF_MESSAGES} more characters are not shown._"))
            self.post_buttons(client, channel, thread, text, "push",
                              {"tree": staged["tree"], "message": message, "requester": requester})

        held.append(show)
        return ("Not pushed yet. The diff and its Approve and Deny buttons are posted in the thread right after your "
                "reply; when an approver clicks Approve, it is committed and pushed. Stop here and tell the person "
                "it waits for their Approve below.")

    def click(self, body: dict, client) -> None:
        """An Approve or Deny click: only an approver's counts, and each change is decided once."""
        clicker = body["user"]["id"]
        action = body["actions"][0]
        channel, message = body["channel"]["id"], body["message"]["ts"]
        if clicker not in self.approvers:
            client.chat_postEphemeral(channel=channel, user=clicker,
                                      text=f"Only {self.names()} can approve or deny a change.")
            return
        with self.lock:
            change = self.waiting.pop(action["value"], None)
        if change is None:
            client.chat_postEphemeral(channel=channel, user=clicker,
                                      text="This change was already decided, or has expired (the agent restarted).")
            return
        if change["kind"] == "push":
            approved = action["action_id"] == "push_approve"
            verdict = "Approved" if approved else "Denied"
            client.chat_update(channel=channel, ts=message, text=f"{verdict} by {self.approvers[clicker]}: "
                               f"commit and push \"{change['message'].splitlines()[0]}\"", blocks=[])
            if approved:
                result = self.code({"code": "push", "requester": change["requester"], "approver": clicker,
                                    "tree": change["tree"], "message": change["message"]})
                client.chat_postMessage(channel=change["channel"], thread_ts=change["thread"],
                                        text=mask(result["output"]))
            return
        command = f"`{shlex.join(change['argv'])}` on {change['host']}"
        if action["action_id"] != "change_approve":
            client.chat_update(channel=channel, ts=message, text=f"Denied by {self.approvers[clicker]}: {command}",
                               blocks=[])
            return
        client.chat_update(channel=channel, ts=message, text=f"Approved by {self.approvers[clicker]}: {command}",
                           blocks=[])
        result = self.run(change["argv"], change["requester"], change["host"], "change", clicker)
        self.post_result(client, change["channel"], change["thread"], change["argv"], change["host"], result)


def result_line(argv: list[str], host: str, result: dict) -> str:
    """One plain line for a change: Done or Failed, from the runner's last "[exit N]" line, or the runner's first
    line when it refused or stopped the command. The full output stays in the runner's log."""
    command = f"`{shlex.join(argv)}` on {host}"
    lines = result["output"].strip().splitlines() or [""]
    exit_code = re.fullmatch(r"\[exit (-?\d+)\]", lines[-1].strip())
    if result["ran"] and exit_code is not None:
        if exit_code.group(1) == "0":
            return f"Done: {command}."
        return f"Failed (exit {exit_code.group(1)}): {command}. Ask me here to look at why."
    return f"Not done: {command}. {lines[0]}"


