NOTES_LIMIT = 4096
MAX_TURNS = 30
def save_notes(path: Path, text: str) -> str | None:
    """Replace the notes, or return why not (over NOTES_LIMIT bytes); old notes stay when refused."""
    size = len(text.encode())
    if size > NOTES_LIMIT:
        return f"refused: {size} bytes, the limit is {NOTES_LIMIT}. Rewrite your notes shorter."
    temporary = path.with_suffix(".tmp")
    temporary.write_text(text)
    temporary.replace(path)
    return None


def rules(config: dict) -> str:
    """The rules for this cluster, filled in from the agent's settings."""
    slurm = config["mode"] == "slurm"
    return SYSTEM_PROMPT.format(
        cluster=config["cluster"],
        front=config["front"],
        front_role="login, Slurm controller, and monitoring machine" if slurm else "monitoring machine",
        machines=", ".join(config["machines"]) or "none",
        docs=", and the user guide (docs.md) and policy (policy.md) from the cluster website" if config["docs"] else "",
        status_examples="the queue, someone's jobs" if slurm else "GPU use, who runs what",
        slurm_reads="Slurm, " if slurm else "",
        history="git -C /var/lib/nanohpc/auto-deploy/config log (every change to cluster.yml and why), "
        if config["code"] and slurm
        else "",
        people="" if config["people"] is None else PEOPLE_PROMPT.format(people=config["people"]),
    )


def deep_rules(config: dict) -> str:
    """The deep agent's rules: with or without code changes and deploys."""
    if config["code"]:
        slurm = config["mode"] == "slurm"
        code = CODE_PROMPT.format(
            after_push=config["after_push"],
            front=config["front"],
            parts=SLURM_PARTS if slurm else MONITOR_PARTS,
            add_user=ADD_USER if slurm else "",
        )
    else:
        code = NO_CODE_PROMPT
    return DEEP_PROMPT.format(code=code)


def system_prompt(config: dict, core: str, notes: str) -> str:
    """The rules, the personality, and its own notes, in that order (stable for caching)."""
    return f"{rules(config)}\n\n# Who you are\n\n{core}\n\n# Your notes\n\n{notes or '(none yet)'}"


def make_answer(config: dict) -> Answer:
    """One Claude Agent SDK query per request: the main model, with the deep model as a subagent."""
    import asyncio

    from claude_agent_sdk import (
        AgentDefinition,
        ClaudeAgentOptions,
        HookMatcher,
        ResultMessage,
        create_sdk_mcp_server,
        query,
        tool,
    )

    source = str(Path(config["source"]).resolve())
    readable = [source, *config["docs"]]
    notes_path = Path(config["notes"])
    machines = ", ".join([config["front"], *config["machines"]])
    work = config["work"]
    core = Path(config["personality"]).read_text()
    people = config["people"]

    async def inside_readable(input_data: dict, tool_use_id: str | None, context) -> dict:
        tool_input = input_data["tool_input"]
        path = os.path.realpath(tool_input.get("file_path") or tool_input.get("path") or source)
        folders = [*readable, work]
        if path == people or any(path == folder or path.startswith(folder + os.sep) for folder in folders):
            return {}
        return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                       "permissionDecisionReason": f"Only files under {', '.join(folders)} may be read."}}

    def answer(prompt: str, budget: float, requester: str, post: Callable[[str], None], status: Callable[[str], None],
               change: Change, push: Push) -> tuple[str, float]:
        @tool("run_command", "Run one read-only command through the runner. argv is the program and its "
              f"arguments, no shell; host is one of: {machines}; doing: what you are checking, in two to four plain "
              'words for the thread\'s status line (for example "the queue", "gpu1\'s GPUs"). The command and its '
              "output are not shown in the thread.", {"argv": list[str], "host": str, "doing": str})
        async def run_command(args: dict) -> dict:
            argv, host = [str(part) for part in args["argv"]], str(args["host"])
            status(str(args["doing"]))
            result = ask_runner(config["socket"], argv, requester, host, "read", None)
            return {"content": [{"type": "text", "text": result["output"]}]}

        @tool("run_change", "Run one command that changes something, through the runner. It runs at once for an "
              "approver; for anyone else, or when could_cut_access is true, it waits for an approver's Approve in "
              f"the thread. argv: the program and its arguments, no shell; host: one of {machines}; reason: why, in "
              "one sentence.", {"argv": list[str], "host": str, "reason": str, "could_cut_access": bool})
        async def run_change(args: dict) -> dict:
            argv = [str(part) for part in args["argv"]]
            told = change(argv, str(args["host"]), str(args["reason"]), bool(args["could_cut_access"]))
            return {"content": [{"type": "text", "text": told}]}

        @tool("write_notes", f"Replace all your notes: people, events, yourself (at most {NOTES_LIMIT} bytes).",
              {"text": str})
        async def write_notes(args: dict) -> dict:
            refused = save_notes(notes_path, str(args["text"]))
            return {"content": [{"type": "text", "text": refused or "saved"}]}

        @tool("start_code_change", f"Put a fresh copy of the cluster.yml repository in {work} for you to edit "
              "(anything there before is removed).", {})
        async def start_code_change(args: dict) -> dict:
            started = ask_code(config["socket"], {"code": "start", "requester": requester})
            post(f"_Work folder: {started['output']}_")
            return {"content": [{"type": "text", "text": started["output"]}]}

        @tool("propose_push", "Show your edits in the work folder as a diff in the thread, with a commit message, "
              "and wait for an approver's Approve; only then are they committed and pushed.", {"message": str})
        async def propose_push(args: dict) -> dict:
            told = push(str(args["message"]))
            return {"content": [{"type": "text", "text": told}]}

        async def edits_in_work(input_data: dict, tool_use_id: str | None, context) -> dict:
            path = os.path.realpath(input_data["tool_input"].get("file_path", ""))
            inside_work = path.startswith(work + os.sep) and not path.startswith(os.path.join(work, ".git"))
            if input_data.get("agent_type") == "deep" and inside_work and config["code"]:
                return {}
            return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                           "permissionDecisionReason": "Only the deep agent may edit, and only "
                                                                       f"files under {work} (not .git)."}}

        async def only_deep(input_data: dict, tool_use_id: str | None, context) -> dict:
            if input_data.get("agent_type") == "deep":
                return {}
            return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                           "permissionDecisionReason": "Only the deep agent may make changes: "
                                                                       "hand the request to it."}}

        async def handing_over(input_data: dict, tool_use_id: str | None, context) -> dict:
            post(f"_Handing this to {config['models']['deep']}: {input_data['tool_input'].get('description', '')}_")
            return {}

        notes = notes_path.read_text() if notes_path.exists() else ""
        read_tools = ["Read", "Grep", "Glob", "mcp__cluster__run_command"]
        code_tools = ["mcp__cluster__start_code_change", "mcp__cluster__propose_push", "Edit", "Write"]
        deep_only = ["mcp__cluster__run_change", *(code_tools if config["code"] else [])]
        tools = [run_command, run_change, write_notes, *([start_code_change, propose_push] if config["code"] else [])]
        options = ClaudeAgentOptions(
            model=config["models"]["main"],
            fallback_model=None,
            system_prompt=system_prompt(config, core, notes),
            tools=["Read", "Grep", "Glob", "Edit", "Write", "Agent"],
            allowed_tools=[*read_tools, *deep_only, "mcp__cluster__write_notes", "Agent"],
            agents={"deep": AgentDefinition(description="For a change on the cluster or in the cluster.yml "
                                            "repository, a problem the first checks did not explain, or a request "
                                            "to investigate.", prompt=deep_rules(config),
                                            tools=[*read_tools, *deep_only], model=config["models"]["deep"])},
            mcp_servers={"cluster": create_sdk_mcp_server("cluster", tools=tools)},
            strict_mcp_config=True,
            permission_mode="dontAsk",
            setting_sources=[],
            # A deploy can take many minutes; the tool call waits for it.
            env={"MCP_TOOL_TIMEOUT": str((DEPLOY_TIMEOUT + 300) * 1000)},
            cwd=source,
            max_turns=MAX_TURNS,
            max_budget_usd=budget,
            hooks={"PreToolUse": [HookMatcher(matcher="Read|Grep|Glob", hooks=[inside_readable]),
                                  HookMatcher(matcher="mcp__cluster__run_change|mcp__cluster__start_code_change|"
                                                      "mcp__cluster__propose_push", hooks=[only_deep]),
                                  HookMatcher(matcher="Edit|Write", hooks=[edits_in_work]),
                                  HookMatcher(matcher="Agent", hooks=[handing_over])]},
        )

        async def run() -> tuple[str, float]:
            reply, cost = "", 0.0
            async for message in query(prompt=prompt, options=options):
                if isinstance(message, ResultMessage):
                    cost = message.total_cost_usd or 0.0
                    reply = message.result or ""
                    models = {name: round(usage.get("costUSD", 0.0), 4)
                              for name, usage in (message.model_usage or {}).items()}
                    # One line per request in the journal: who, cost, cost per model, and the reply.
                    print(json.dumps({"requester": requester, "cost": round(cost, 4), "models": models,
                                      "reply": mask(reply)}), flush=True)
                    if message.subtype == "error_max_budget_usd":
                        reply += f"\n\n_Stopped: this request reached its limit of ${budget:.2f}._"
                    elif message.subtype == "error_max_turns":
                        reply += "\n\n_Stopped: this request reached its step limit._"
                    elif message.is_error:
                        reply += f"\n\n_Stopped with an error: {message.subtype}._"
            return reply or "_No answer._", cost

        return asyncio.run(run())

    return answer


def serve_bot(config: dict) -> None:
    """Connect to Slack (Socket Mode) and answer events one at a time."""
    from slack_bolt import App
    from slack_bolt.adapter.socket_mode import SocketModeHandler

    bot_token = os.environ.pop("SLACK_BOT_TOKEN")
    app_token = os.environ.pop("SLACK_APP_TOKEN")
    if not os.environ.get("ANTHROPIC_API_KEY"):
        raise SystemExit("ANTHROPIC_API_KEY is not set")
    zone = ZoneInfo(config["timezone"]) if config["timezone"] else None
    ledger = Ledger(Path(config["usage"]), config["limits"], zone)
    answer = make_answer(config)

    def run(argv: list[str], requester: str, host: str, mode: str, approver: str | None) -> dict:
        return ask_runner(config["socket"], argv, requester, host, mode, approver)

    def code(request: dict) -> dict:
        return ask_code(config["socket"], request)

    approvals = Approvals(config["approvers"], run, code)
    one_at_a_time = threading.Lock()
    app = App(token=bot_token)

    def on_event(event: dict, client) -> None:
        with one_at_a_time:
            handle_event(event, config, ledger, client, answer, approvals, datetime.now().astimezone(zone))

    def on_click(ack, body: dict, client) -> None:
        ack()
        approvals.click(body, client)

    app.event("app_mention")(on_event)
    app.event("message")(on_event)
    for action in ("change_approve", "change_deny", "push_approve", "push_deny"):
        app.action(action)(on_click)
    SocketModeHandler(app, app_token).start()


def serve_runner_from(config: dict) -> None:
    """Start the runner from its settings file (written by nanoHPC's deploy, root only)."""
    approvers = list(config["approvers"])
    rule = RunnerRule(config["front"], approvers, config["hosts"], config["key"], config["known_hosts"],
                      config["slurm"])
    repository = config["repository"]
    code = None
    if repository is not None:
        code = CodeChanges(repository["remote"], repository["branch"], repository["clone"], config["work"],
                           config["agent_user"], repository["key"], repository["known_hosts"], approvers,
                           repository["author"], repository["email"], repository["after_push"])
    deploys = None if config["deploy"] is None else Deploys(config["deploy"])
    serve_runner(config["socket"], config["socket_group"], Path(config["log"]), rule, code, deploys)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("part", choices=("runner", "bot"), help="runner: run commands (root); bot: Slack and Claude")
    parser.add_argument("--config", type=Path, required=True, help="the part's settings (JSON)")
    args = parser.parse_args()
    config = json.loads(args.config.read_text())
    if args.part == "runner":
        serve_runner_from(config)
    else:
        serve_bot(config)


if __name__ == "__main__":
    main()
