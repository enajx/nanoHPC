# ---------------------------------------------------------------- shared: secrets in text

SECRET_PATTERNS = [
    re.compile(r"xox[abposr]-[A-Za-z0-9-]+"),
    re.compile(r"xapp-[A-Za-z0-9-]+"),
    re.compile(r"sk-ant-[A-Za-z0-9_-]+"),
    re.compile(r"https://hooks\.slack\.com/services/\S+"),
    re.compile(r"NANOHPC_[A-Z_]*(SECRET|TOKEN|KEY|WEBHOOK)=\S+"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.DOTALL),
    # Password hashes, as in /etc/shadow.
    re.compile(r"\$(1|2[aby]?|5|6|y|gy|7)\$[^\s:]+"),
]


def mask(text: str) -> str:
    """Replace anything that looks like a Slack token, Anthropic key, webhook, nanoHPC secret, or private key."""
    for pattern in SECRET_PATTERNS:
        text = pattern.sub("[hidden]", text)
    return text


