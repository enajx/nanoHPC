#!/usr/bin/env bash
# Report whether this machine's nanoHPC parts work, for the roles it has in cluster.yml
# (/etc/nanohpc/roles). One line per check:
#   ok    the check passed
#   FAIL  something nanoHPC set up is broken (a service, a mount, Slurm not answering); exit code 1
#   WARN  a state to look at that is not a setup error (a drained node, a full disk); exit code unchanged
# With --metrics PATH it also writes each check's state as a node_exporter textfile at PATH:
#   cluster_health_check_state{check="<id>"} 0 ok, 1 warning, 2 failing
#   cluster_health_timestamp_seconds          when this run finished
# The id is the label cut at the first " (" or ":", so it stays the same when numbers or machine lists change.
# In monitor mode (/etc/nanohpc/mode), checks use measured machine health and accepted GPU inventory without Slurm.
set -uo pipefail

usage() {
  echo "usage: cluster-health [--metrics PATH]" >&2
  exit 2
}

metrics_path=""
while test "$#" -gt 0; do
  case "$1" in
    --metrics)
      test "$#" -ge 2 -a -n "${2:-}" || usage
      metrics_path=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

# Tests set NANOHPC_HEALTH_TEST_ROOT to a folder holding fake etc/nanohpc and var/lib/nanohpc; empty on machines.
root=${NANOHPC_HEALTH_TEST_ROOT:-}
roles=" $(cat "$root/etc/nanohpc/roles" 2>/dev/null) "
problems=0
check_ids=()
check_states=()
gpu_inventory_mismatch=""

has() { case "$roles" in *" $1 "*) return 0 ;; esac; return 1; }

# Print one report line and keep the check's state for the metrics. A second check with the same id keeps the worst state.
report() {
  local result=$1 label=$2 state id i
  case "$result" in
    ok) state=0 ;;
    WARN) state=1 ;;
    FAIL) state=2 problems=1 ;;
  esac
  printf '%-5s %s\n' "$result" "$label"
  id=${label%%" ("*}
  id=${id%%:*}
  id=${id#"${id%%[![:space:]]*}"}
  id=${id%"${id##*[![:space:]]}"}
  for i in "${!check_ids[@]}"; do
    if test "${check_ids[$i]}" = "$id"; then
      test "$state" -gt "${check_states[$i]}" && check_states[$i]=$state
      return 0
    fi
  done
  check_ids+=("$id")
  check_states+=("$state")
}

# Escape a label value for the Prometheus text format: backslash, double quote, newline.
escape_label() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '%s' "$value"
}

# Write the kept states to PATH through a temporary file in the same folder, so node_exporter never reads half a file.
write_metrics() {
  local path=$1 temporary i
  temporary=$(mktemp "$(dirname "$path")/.cluster-health.XXXXXX") || exit 1
  {
    echo "# HELP cluster_health_check_state State of each cluster-health check on this machine: 0 ok, 1 warning, 2 failing."
    echo "# TYPE cluster_health_check_state gauge"
    for i in "${!check_ids[@]}"; do
      printf 'cluster_health_check_state{check="%s"} %s\n' "$(escape_label "${check_ids[$i]}")" "${check_states[$i]}"
    done
    echo "# HELP cluster_health_timestamp_seconds When cluster-health last finished on this machine (Unix time)."
    echo "# TYPE cluster_health_timestamp_seconds gauge"
    echo "cluster_health_timestamp_seconds $(date +%s)"
    if test -n "$gpu_inventory_mismatch"; then
      echo "# HELP cluster_monitor_gpu_inventory_mismatch Accepted GPU inventory differs from the current measured inventory."
      echo "# TYPE cluster_monitor_gpu_inventory_mismatch gauge"
      echo "cluster_monitor_gpu_inventory_mismatch $gpu_inventory_mismatch"
    fi
  } >"$temporary" || exit 1
  chmod 0644 "$temporary" || exit 1
  mv -f "$temporary" "$path" || exit 1
}

check() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then
    report ok "$label"
  else
    report FAIL "$label"
  fi
}

note() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then
    report ok "$label"
  else
    report WARN "$label"
  fi
}

# Tests source this file to call report and write_metrics directly; stop here when sourced.
if test "${BASH_SOURCE[0]}" != "$0"; then
  return 0
fi

disk() {
  local used inodes
  used=$(df --output=pcent "$1" 2>/dev/null | tail -1 | tr -dc 0-9)
  inodes=$(df --output=ipcent "$1" 2>/dev/null | tail -1 | tr -dc 0-9)
  note "disk $1: ${used:-?}% space, ${inodes:-?}% inodes used (warning from 90%)" \
    test "${used:-100}" -lt 90 -a "${inodes:-0}" -lt 90
}

check "nanoHPC roles are recorded" test -s "$root/etc/nanohpc/roles"
disk /
check "service nanohpc-node-exporter (metrics)" systemctl is-active --quiet nanohpc-node-exporter
note "metrics certificate valid for at least 30 more days" sh -c \
  'openssl x509 -noout -checkend 2592000 -in /etc/nanohpc/metrics-tls/$(test -f /etc/nanohpc/metrics-tls/prometheus.crt && echo prometheus || echo node).crt'

# Compare the accepted GPU inventory with the last fresh local specs collector result. A missing or old
# reading is unknown, not proof that hardware has changed or stayed the same.
monitor_gpu_inventory_state() {
  python3 - "$root/etc/nanohpc/monitor-gpus.json" "$root/var/lib/nanohpc/metrics-textfile/specs.prom" <<'PY'
import json
import re
import sys
import time
from pathlib import Path

accepted = json.loads(Path(sys.argv[1]).read_text())
lines = Path(sys.argv[2]).read_text().splitlines()
stamps = [float(line.split()[1]) for line in lines if line.startswith("cluster_machine_specs_timestamp_seconds ")]
if len(stamps) != 1 or not 0 <= time.time() - stamps[0] < 900:
    print("stale")
    sys.exit(0)
counts = [int(float(line.split()[1])) for line in lines if line.startswith("cluster_machine_gpu_count ")]
models = []
for line in lines:
    if line.startswith("cluster_machine_gpu_memory_bytes{"):
        match = re.search(r'model=("(?:\\.|[^"\\])*")}', line)
        if match is None:
            print("invalid")
            sys.exit(0)
        models.append(json.loads(match[1]))
if len(counts) != 1 or counts[0] < 0 or len(models) != counts[0]:
    print("invalid")
elif counts[0] == accepted["count"] and sorted(models) == sorted(accepted["models"]):
    print("match")
else:
    print("changed")
PY
}

mode=$(cat "$root/etc/nanohpc/mode" 2>/dev/null || true)
if test "$mode" = monitor; then
  check "monitor role is recorded" sh -c 'test "$1" = monitor -o "$1" = machine' sh \
    "$(tr -d '\n' < "$root/etc/nanohpc/roles")"
  check "machine specs collector timer" systemctl is-active --quiet nanohpc-machine-specs.timer
  check "the machine specs collector's last run worked" sh -c '! systemctl is-failed --quiet nanohpc-machine-specs.service'
  if test -f "$root/etc/systemd/system/nanohpc-gpu-metrics.timer"; then
    check "GPU metrics collector timer" systemctl is-active --quiet nanohpc-gpu-metrics.timer
    check "the GPU metrics collector's last run worked" sh -c '! systemctl is-failed --quiet nanohpc-gpu-metrics.service'
  fi
  check "accepted GPU inventory is recorded" test -s "$root/etc/nanohpc/monitor-gpus.json"
  if test -s "$root/etc/nanohpc/monitor-gpus.json"; then
    gpu_state=$(monitor_gpu_inventory_state)
    case "$gpu_state" in
      match) gpu_inventory_mismatch=0; report ok "GPU inventory matches accepted hardware" ;;
      changed) gpu_inventory_mismatch=1; report FAIL "GPU inventory matches accepted hardware" ;;
      stale) report WARN "GPU inventory reading is fresh" ;;
      *) report FAIL "GPU inventory reading is valid" ;;
    esac
  fi
  if has monitor; then
    for service in nanohpc-prometheus nanohpc-history nanohpc-alertmanager nanohpc-grafana; do
      check "service $service" systemctl is-active --quiet "$service"
    done
    check "status collector timer" systemctl is-active --quiet nanohpc-monitor-snapshot.timer
    check "the status collector's last run worked" sh -c '! systemctl is-failed --quiet nanohpc-monitor-snapshot.service'
    check "the status snapshot is fresh (under 2 minutes old)" \
      test "$(( $(date +%s) - $(stat -c %Y "$root/var/lib/nanohpc/monitor/status.json" 2>/dev/null || echo 0) ))" -lt 120
    check "website address is recorded" test -s "$root/etc/nanohpc/website/address"
    if test -s "$root/etc/nanohpc/website/address"; then
      read -r web_host web_path < "$root/etc/nanohpc/website/address"
      check "service nginx (website)" systemctl is-active --quiet nginx
      for page in "" site.json grafana/d/nanohpc-machines; do
        check "the website answers over HTTPS (${web_path}${page})" \
          curl -sfk -o /dev/null --max-time 10 --resolve "$web_host:443:127.0.0.1" "https://$web_host${web_path}${page}"
      done
      note "the website certificate is valid for at least 14 more days" sh -c \
        "openssl s_client -connect 127.0.0.1:443 -servername '$web_host' </dev/null 2>/dev/null | openssl x509 -noout -checkend 1209600"
      if test -f "$root/etc/systemd/system/nanohpc-website-certificate.timer"; then
        check "website certificate renewal timer" systemctl is-active --quiet nanohpc-website-certificate.timer
        note "the last website certificate renewal check worked" \
          sh -c '! systemctl is-failed --quiet nanohpc-website-certificate.service'
      fi
    fi
  fi
  if test -n "$metrics_path"; then
    write_metrics "$metrics_path"
  fi
  exit "$problems"
fi


if has front || has compute; then
  check "service munge" systemctl is-active --quiet munge
fi

if has home; then
  check "/home is mounted" mountpoint -q /home
  check "service nfs-server" systemctl is-active --quiet nfs-server
  check "home quota reader timer" systemctl is-active --quiet nanohpc-home-quotas.timer
  check "the home quota reader's last run worked" sh -c '! systemctl is-failed --quiet nanohpc-home-quotas.service'
  disk /home
  # The nightly backup writes its result as metrics; only once a backup is configured.
  if test -f "$root/etc/nanohpc/backup/enabled"; then
    backup_metrics=$root/var/lib/nanohpc/metrics-textfile/backup.prom
    last_success=$(awk '$1 == "cluster_backup_last_success_timestamp_seconds" { print int($2) }' "$backup_metrics" 2>/dev/null)
    last_exit=$(awk '$1 == "cluster_backup_last_exit_code" { print int($2) }' "$backup_metrics" 2>/dev/null)
    # No age warning before the backup's first night: only once the backup was set up more than 26 hours ago.
    if test -n "$(find "$root/etc/nanohpc/backup/started" -mmin +1560 2>/dev/null)"; then
      note "the last successful /home backup is less than 26 hours old" \
        test "$(( $(date +%s) - ${last_success:-0} ))" -lt 93600
    fi
    note "the last /home backup run worked" test "${last_exit:-0}" = 0
  fi
elif ! has backup; then
  check "/home is the shared NFS mount" sh -c 'findmnt -n -o FSTYPE --mountpoint /home | grep -qx nfs4'
  # A hung NFS server makes /home hang rather than fail; the timeout turns that into a failure.
  check "/home answers within 10 seconds" timeout 10 stat -t /home/.
fi

if has front; then
  for service in mariadb slurmdbd slurmctld nanohpc-prometheus nanohpc-history nanohpc-alertmanager nanohpc-grafana; do
    check "service $service" systemctl is-active --quiet "$service"
  done
  check "the Slurm controller answers" scontrol ping
  if test -f /etc/systemd/system/nanohpc-auto-deploy.timer; then
    check "automatic deploy timer" systemctl is-active --quiet nanohpc-auto-deploy.timer
    note "the last automatic deploy worked (journalctl -u nanohpc-auto-deploy)" sh -c \
      '! grep -q "^cluster_auto_deploy_last_exit_code [1-9]" /var/lib/nanohpc/metrics-textfile/auto-deploy.prom 2>/dev/null'
    # A run that was killed (timeout, out of memory) writes no result; the service is then failed.
    note "the last automatic deploy run finished" sh -c '! systemctl is-failed --quiet nanohpc-auto-deploy.service'
  fi
  if test -f /etc/systemd/system/nanohpc-deploy-hook.service; then
    check "service nanohpc-deploy-hook (GitHub webhook)" systemctl is-active --quiet nanohpc-deploy-hook
  fi
  if test -f /etc/nanohpc/website/address; then
    read -r web_host web_path < /etc/nanohpc/website/address
    check "service nginx (website)" systemctl is-active --quiet nginx
    for page in "" site.json grafana/d/nanohpc-overview; do
      check "the website answers over HTTPS (${web_path}${page})" \
        curl -sfk -o /dev/null --max-time 10 --resolve "$web_host:443:127.0.0.1" "https://$web_host${web_path}${page}"
    done
    note "the website certificate is valid for at least 14 more days" sh -c \
      "openssl s_client -connect 127.0.0.1:443 -servername '$web_host' </dev/null 2>/dev/null | openssl x509 -noout -checkend 1209600"
    if test -f /etc/systemd/system/nanohpc-website-certificate.timer; then
      check "website certificate renewal timer" systemctl is-active --quiet nanohpc-website-certificate.timer
      note "the last website certificate renewal check worked" \
        sh -c '! systemctl is-failed --quiet nanohpc-website-certificate.service'
    fi
  fi
  check "status collector timer" systemctl is-active --quiet nanohpc-monitor-snapshot.timer
  check "the status collector's last run worked" sh -c '! systemctl is-failed --quiet nanohpc-monitor-snapshot.service'
  check "the status snapshot is fresh (under 2 minutes old)" \
    test "$(( $(date +%s) - $(stat -c %Y /var/lib/nanohpc/monitor/status.json 2>/dev/null || echo 0) ))" -lt 120
  # Ask the front node's Prometheus which machines have a metrics problem. If Prometheus does not answer,
  # say so rather than reporting no problems.
  problem_machines() {
    local answer
    answer=$(curl -sf --max-time 10 -G "http://127.0.0.1:${2:-9090}/api/v1/query" --data-urlencode "query=$1") || return 1
    printf '%s' "$answer" | python3 -c '
import json, sys
answer = json.load(sys.stdin)
if answer.get("status") != "success":
    sys.exit(1)
print(",".join(sorted({r["metric"].get("machine", r["metric"].get("rule_group", "cluster")) for r in answer["data"]["result"]})))
'
  }
  metric_check() {
    local label=$1 query=$2 machines
    if machines=$(problem_machines "$query"); then
      note "$label${machines:+ ($machines)}" test -z "$machines"
    else
      report WARN "$label (Prometheus did not answer)"
    fi
  }
  # Only the node_exporter collectors nanoHPC relies on; others can fail harmlessly on some machines.
  metric_check "metrics arrive from every machine" 'up{job=~"node.*"} == 0 or node_textfile_scrape_error == 1 or node_scrape_collector_success{collector=~"cpu|meminfo|filesystem|systemd|textfile"} == 0'
  metric_check "GPU readings are fresh (under 2 minutes old)" 'time() - cluster_gpu_collection_timestamp_seconds > 120'
  metric_check "machine specs are fresh (under 15 minutes old)" 'time() - cluster_machine_specs_timestamp_seconds > 900'
  metric_check "home quotas are fresh (under 15 minutes old)" 'time() - cluster_home_quota_collected_timestamp_seconds > 900 or absent(cluster_home_quota_collected_timestamp_seconds)'
  # Alerts that cannot reach Alertmanager, or Slack posts that fail, would otherwise go unnoticed.
  metric_check "alerts are delivered (Prometheus to Alertmanager, Alertmanager to Slack)" 'increase(prometheus_notifications_dropped_total[1h]) > 0 or increase(alertmanager_notifications_failed_total[1h]) > 0'
  metric_check "the daily summary rules evaluate" 'increase(prometheus_rule_evaluation_failures_total[10m]) > 0'
  # The history instance collects once a day; after its first two days it must hold daily summaries.
  history_age=$(( $(date +%s) - $(stat -c %Y /etc/nanohpc/prometheus/history-started 2>/dev/null || date +%s) ))
  if test "$history_age" -gt 172800; then
    if summaries=$(problem_machines 'count(cluster_daily_scrape_coverage_ratio) > 0' 9091); then
      note "the 5-year history holds daily summaries" test -n "$summaries"
    else
      report WARN "the 5-year history holds daily summaries (history Prometheus did not answer)"
    fi
  fi
  # Every metrics certificate the front node issued, so an expiry shows up even without a deploy.
  expiring=""
  for cert in /etc/nanohpc/metrics-ca/issued/*.crt; do
    test -f "$cert" || continue
    openssl x509 -noout -checkend 2592000 -in "$cert" >/dev/null 2>&1 || expiring="$expiring $(basename "$cert" .crt)"
  done
  note "metrics certificates valid for at least 30 more days${expiring:+ (expiring:$expiring; run nanohpc deploy)}" test -z "$expiring"
  if nodes=$(sinfo -h -N -t down,drain,fail,unknown,no_respond,maint -o '%N %T' 2>/dev/null); then
    nodes=$(printf '%s\n' "$nodes" | sed '/^$/d' | sort -u | paste -sd ',' -)
    note "no Slurm node is down, drained, not responding, or in maintenance${nodes:+ ($nodes)}" test -z "$nodes"
  else
    check "sinfo lists the Slurm nodes" false
  fi
fi

if has compute; then
  check "service slurmd" systemctl is-active --quiet slurmd
  check "/scratch is mounted" mountpoint -q /scratch
  check "/scratch has its staging and lock folders" test -d /scratch/staged/private -a -f /scratch/locks/capacity.lock
  disk /scratch
  check "scratch cleanup timer" systemctl is-active --quiet nanohpc-scratch-cleanup.timer
fi

if test -n "$metrics_path"; then
  write_metrics "$metrics_path"
fi
exit "$problems"
