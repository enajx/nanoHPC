#!/usr/bin/python3
"""Forced command of the home machine's home-copy key on a front or login node with its own /home (root's
authorized_keys, from the home machine's address only): receive one user's listed files into their own home folder.

Allowed: the rsync server command line, as rsync 3.2 and 3.4 clients send it, writing only to ROOT/USER/ (ROOT:
/home), where ROOT/USER is a folder (not a link) owned by a user other than root; short options from a fixed list and
the long options --delete (and rsync's --delete-before/during/after/delay forms), --timeout=N and --max-size=N.
Never links, device files, owners, or groups (no l, D, o, or g option), and never --delete-excluded, so the user's
other files stay. Words may hold only letters, digits and `._/=-`. Anything else prints a message on stderr and exits
1. An allowed command runs without a shell, as the folder's owner (setpriv), so it can only write what that user
could. NANOHPC_HOME_COPY_ROOT is for tests.
"""

import os
import pwd
import re
import stat
import sys

ROOT = os.environ.get("NANOHPC_HOME_COPY_ROOT", "/home")
SAFE_COMMAND = re.compile(r"[A-Za-z0-9._/= -]+")
USER = re.compile(r"[A-Za-z_][A-Za-z0-9_-]*")
# One short option group: flags without arguments, then rsync's "e." capability letters.
SHORT_OPTIONS = re.compile(r"-[vqtprcuWIxSdOJNU]*e\.[A-Za-z]*")
LONG_OPTIONS = re.compile(r"--(delete|delete-before|delete-during|delete-after|delete-delay|timeout=[0-9]+"
                          r"|max-size=[0-9]+)")  # fmt: skip


def refuse(reason: str) -> None:
    """Print why the command was refused and exit 1."""
    print("nanohpc-home-copy-receive: refused: " + reason, file=sys.stderr)
    sys.exit(1)


def allowed(command: str) -> tuple[list[str], os.stat_result]:
    """Return the words of an allowed rsync server command line and its home folder's details; refuse anything
    else."""
    if not SAFE_COMMAND.fullmatch(command):
        refuse("only an rsync server command with plain characters is allowed")
    words = command.split(" ")
    if words[:2] != ["rsync", "--server"] or "--sender" in words:
        refuse("only 'rsync --server' receiving is allowed")
    options = words[2:-2]
    if not options or not SHORT_OPTIONS.fullmatch(options[0]):
        refuse("the short rsync options are missing or not allowed")
    for option in options[1:]:
        if not LONG_OPTIONS.fullmatch(option):
            refuse("rsync option not allowed: " + option)
    target = words[-1]
    user = target.removeprefix(ROOT + "/").removesuffix("/")
    if len(words) < 5 or words[-2] != "." or target != f"{ROOT}/{user}/" or not USER.fullmatch(user):
        refuse(f"the command must end with '. {ROOT}/USER/'")
    if not os.path.lexists(target):
        refuse("no such home folder: " + target)
    details = os.lstat(target)
    if not stat.S_ISDIR(details.st_mode) or details.st_uid == 0:
        refuse("not a user's own home folder: " + target)
    return words, details


def main() -> None:
    """Check the client's command, then run it as the home folder's owner, without a shell."""
    words, details = allowed(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
    owner = pwd.getpwuid(details.st_uid)
    os.execvp("setpriv", ["setpriv", f"--reuid={owner.pw_uid}", f"--regid={owner.pw_gid}", "--init-groups",
                          "--no-new-privs", "--", *words])  # fmt: skip


if __name__ == "__main__":
    main()
