#!/usr/bin/python3
"""Copy each user's listed files from the shared /home into the own /home of the front and login nodes that keep
their own (home_mount: own), every night (run as root on the home machine by nanohpc-home-copy.timer).

For each --to NAME=ADDRESS and each user: rsync SOURCE/USER/ to root@ADDRESS:/home/USER/. Only the backup's file
list goes (HOME_FILES and home_rules in cluster-backup, next to this program), after the cluster's --exclude
patterns as in the backup, with no file over MAX_FILE_SIZE. A listed file deleted here is deleted there; every other
file in the node's home stays (rsync --delete without --delete-excluded). Plain files and folders only: no links,
device files, owners, or groups, and no setuid or setgid bits.

The sending rsync runs as the user (setpriv with the user's IDs and groups, no new privileges), so it reads only
what that user can: a link in their home to a file only root may read gives them nothing. The copy key stays with
root: rsync's transport (--rsh) is this program's relay, which passes rsync's remote command line and then the
data over a socket pair to this root process. Root checks the command (an rsync server into /home/USER/ of that
user only), then runs ssh with the key and the pinned host keys, its input and output on that socket. The node's
root key file accepts the key only from the home machine's address, for nanohpc-home-copy-receive, which runs rsync
there as the owner of that home folder.

Each copy (one user to one node) has a time limit (--copy-timeout): after it, its rsync and ssh are stopped and that
copy counts as failed, so a user who stops or slows their own rsync, or a node that stops answering (ssh checks
every 30 seconds), never holds up the other copies. The relay runs as isolated Python (-I) in a clean environment,
so nothing in the user's home runs in it. A user whose home folder here is missing, a link, or not theirs is not
copied. rsync's exit code 24 (files that
vanished while being copied) counts as success. Exits 1 when any copy failed, after trying every node and user;
rsync's and ssh's own messages go to stderr (the journal).
"""

import argparse
import importlib.machinery
import importlib.util
import os
import pwd
import re
import select
import socket
import stat
import subprocess
import sys
import threading
import time
from pathlib import Path
from types import ModuleType

SAFE_COMMAND = re.compile(r"[A-Za-z0-9._/= -]+")


def backup_module() -> ModuleType:
    """Load cluster-backup from this program's folder, the one place the file list is written."""
    path = Path(__file__).resolve().parent / "cluster-backup"
    loader = importlib.machinery.SourceFileLoader("cluster_backup", str(path))
    spec = importlib.util.spec_from_loader("cluster_backup", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def rsync_command(backup: ModuleType, source: Path, user: str, address: str, excludes: list[str], fd: int) -> list[str]:
    """The user's rsync command for one node: its transport is this program's relay on file descriptor `fd`."""
    # -I: isolated Python, so nothing in the user's home (a user site folder, PYTHON* variables) runs in the relay.
    relay = f"{sys.executable} -I {Path(__file__).resolve()} --relay {fd}"
    return ["rsync", "--recursive", "--times", "--perms", "--chmod=ug-s", "--delete", "--timeout=600",
            "--rsh=" + relay, *["--exclude=" + pattern for pattern in excludes], *backup.home_rules("/"),
            "--max-size=" + backup.MAX_FILE_SIZE, "--exclude=*", f"{source}/{user}/", f"root@{address}:/home/{user}/"]  # fmt: skip


def relay(fd: int, arguments: list[str]) -> None:
    """The transport rsync starts (as the user): send rsync's remote command line, then pass data both ways
    between rsync (standard input and output) and root's ssh (the socket)."""
    channel = socket.socket(fileno=fd)
    command = arguments[arguments.index("rsync") :]
    channel.sendall((" ".join(command) + "\n").encode())

    def upload() -> None:
        while data := os.read(0, 65536):
            channel.sendall(data)
        channel.shutdown(socket.SHUT_WR)

    threading.Thread(target=upload, daemon=True).start()
    while data := channel.recv(65536):
        view = memoryview(data)
        while view:
            view = view[os.write(1, view) :]


def first_line(channel: socket.socket, deadline: float) -> str | None:
    """Read the relay's command line (up to 4096 bytes, before the copy's deadline); None when it does not come."""
    line = b""
    while not line.endswith(b"\n") and len(line) < 4096:
        if not select.select([channel], [], [], max(0.0, deadline - time.monotonic()))[0]:
            return None
        byte = channel.recv(1)
        if not byte:
            return None
        line += byte
    return line.decode(errors="replace").strip()


def allowed(command: str, user: str) -> bool:
    """Whether the command is an rsync server that receives into that user's home on the node, and nothing else."""
    words = command.split(" ")
    return (
        SAFE_COMMAND.fullmatch(command) is not None
        and words[:2] == ["rsync", "--server"]
        and "--sender" not in words
        and len(words) >= 5
        and words[-2:] == [".", f"/home/{user}/"]
    )


def stop(processes: list[subprocess.Popen[bytes]]) -> None:
    """Kill the processes of a copy that took too long, and wait for them."""
    for process in processes:
        process.kill()
    for process in processes:
        process.wait()


def copy(arguments: argparse.Namespace, backup: ModuleType, name: str, address: str, user: str) -> bool:
    """Copy one user's listed files to one node; return whether it worked."""
    folder = arguments.source / user
    details = os.lstat(folder) if os.path.lexists(folder) else None
    owner = pwd.getpwnam(user) if details is not None else None
    if details is None or owner is None or not stat.S_ISDIR(details.st_mode) or details.st_uid != owner.pw_uid:
        print(f"nanohpc-home-copy: {folder} is not {user}'s own folder; not copied", file=sys.stderr)
        return False
    deadline = time.monotonic() + arguments.copy_timeout
    root_end, user_end = socket.socketpair()
    rsync = subprocess.Popen(
        ["setpriv", f"--reuid={owner.pw_uid}", f"--regid={owner.pw_gid}", "--init-groups", "--no-new-privs", "--",
         *rsync_command(backup, arguments.source, user, address, arguments.exclude, user_end.fileno())],
        stdin=subprocess.DEVNULL, pass_fds=[user_end.fileno()], env={"PATH": os.environ["PATH"], "LANG": "C.UTF-8"},
    )  # fmt: skip
    user_end.close()
    command = first_line(root_end, deadline)
    if command is None and time.monotonic() >= deadline:
        root_end.close()
        stop([rsync])
        print(f"nanohpc-home-copy: the copy of {user} to {name} took longer than {arguments.copy_timeout} seconds; "
              "stopped", file=sys.stderr)  # fmt: skip
        return False
    if command is None or not allowed(command, user):
        print(f"nanohpc-home-copy: refused the remote command for {user} on {name}: {command!r}", file=sys.stderr)
        root_end.close()
        stop([rsync])
        return False
    ssh = subprocess.Popen(
        ["ssh", "-i", arguments.key, "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o",
         "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile=" + arguments.known_hosts, "-o", "ConnectTimeout=20",
         "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=4", "-e", "none", "-T", f"root@{address}",
         command],
        stdin=root_end, stdout=root_end,
    )  # fmt: skip
    root_end.close()
    try:
        ssh.wait(timeout=max(0.0, deadline - time.monotonic()))
        code = rsync.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        stop([ssh, rsync])
        print(f"nanohpc-home-copy: the copy of {user} to {name} took longer than {arguments.copy_timeout} seconds; "
              "stopped", file=sys.stderr)  # fmt: skip
        return False
    if code not in (0, 24):
        print(f"nanohpc-home-copy: the copy of {user} to {name} failed (rsync exit {code})", file=sys.stderr)
        return False
    return True


def main() -> None:
    """Copy every user to every node, then report the copies that failed. With --relay FD: be rsync's transport."""
    if len(sys.argv) > 2 and sys.argv[1] == "--relay":
        relay(int(sys.argv[2]), sys.argv[3:])
        return
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--source", type=Path, required=True, help="the shared /home")
    parser.add_argument("--to", action="append", required=True, help="NAME=ADDRESS of a node with its own /home")
    parser.add_argument("--users", nargs="+", required=True)
    parser.add_argument("--exclude", action="append", default=[], help="the backup's exclude patterns")
    parser.add_argument("--copy-timeout", type=int, required=True, help="seconds one user's copy to one node may take")
    parser.add_argument("--key", required=True)
    parser.add_argument("--known-hosts", required=True)
    arguments = parser.parse_args()
    backup = backup_module()
    failed = []
    for item in arguments.to:
        name, address = item.split("=", 1)
        for user in arguments.users:
            if not copy(arguments, backup, name, address, user):
                failed.append(f"{name}:{user}")
    if failed:
        print(f"nanohpc-home-copy: failed for {', '.join(failed)}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
