#!/usr/bin/python3
"""Publish selected home quota totals as node_exporter metrics, for the status collector on the front node.

Runs as root on the home machine. Reads user block quotas with `repquota -u -v -O csv FILESYSTEM` and writes a
node_exporter textfile (mode 0644) with, for each named user:
  cluster_home_quota_used_bytes{user="NAME"}, cluster_home_quota_soft_bytes{user="NAME"},
  cluster_home_quota_hard_bytes{user="NAME"}
and cluster_home_quota_collected_timestamp_seconds (when repquota was read, in Unix seconds).
The file is replaced whole, and only when every named user has a valid quota record: any failure leaves the
last good file (its timestamp then shows how old it is).

On a front or login node with its own /home (home_mount: own), it runs with --notice-dir instead of --output: it
writes no metrics (the front node's job hold reads only the shared /home), and writes each named user's private
usage box for the login banner (mode 0400, owned by that user, replaced whole), with a notice at or above the soft
threshold. Going over the hard threshold there holds no jobs. Boxes of users not named are removed.

Arguments (one of --output and --notice-dir):
  --output PATH            the .prom file to write, in node_exporter's textfile folder.
  --notice-dir PATH        the folder of the usage boxes (root-owned, users may enter it but not list it).
  --repquota PATH          the repquota program (for example /usr/sbin/repquota).
  --filesystem PATH        mount point of the filesystem that holds /home and its quotas: /home when it is
                           its own mount, / when /home is a folder on the root disk.
  --soft-bytes INTEGER    configured notice threshold, independent of filesystem limits.
  --hard-bytes INTEGER    configured job wait threshold, independent of filesystem limits.
  --users NAME [NAME ...]  the cluster's users; nobody else (root, service accounts) is written.
"""

import argparse
import csv
import json
import os
import pwd
import re
import subprocess
import tempfile
import time
from pathlib import Path


def collect(
    repquota: str, filesystem: str, users: list[str], soft_bytes: int, hard_bytes: int
) -> dict[str, dict[str, int]]:
    """Read filesystem quota blocks and retain only named cluster users."""
    if (
        not users
        or len(users) != len(set(users))
        or any(not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*", user) for user in users)
    ):
        raise ValueError("Invalid cluster user list")
    if soft_bytes <= 0 or hard_bytes < soft_bytes:
        raise ValueError("Invalid configured quota thresholds")
    output = subprocess.run(
        [repquota, "-u", "-v", "-O", "csv", filesystem], capture_output=True, text=True, check=True, timeout=25
    ).stdout
    rows = csv.DictReader(output.splitlines())
    required = {"User", "BlockUsed"}
    if rows.fieldnames is None or not required.issubset(rows.fieldnames):
        raise ValueError("Quota output is missing required columns")
    selected: dict[str, dict[str, int]] = {}
    for row in rows:
        name = row["User"]
        if name not in users:
            continue
        if name in selected:
            raise ValueError("Duplicate quota record for " + name)
        raw_used = row["BlockUsed"]
        if raw_used is None or not re.fullmatch(r"[0-9]+", raw_used):
            raise ValueError("Invalid quota usage for " + name)
        selected[name] = {"used_bytes": int(raw_used) * 1024, "soft_bytes": soft_bytes, "hard_bytes": hard_bytes}
    if set(selected) != set(users):
        raise ValueError("Missing cluster user quota record")
    return selected


def metrics(quotas: dict[str, dict[str, int]], collected: float) -> str:
    """Write each user's used, soft, and hard bytes, and when they were read."""
    lines = []
    for field, meaning in [
        ("used_bytes", "Bytes used in /home"),
        ("soft_bytes", "Configured notice threshold on /home in bytes"),
        ("hard_bytes", "Configured job wait threshold on /home in bytes"),
    ]:
        lines += [f"# HELP cluster_home_quota_{field} {meaning}.", f"# TYPE cluster_home_quota_{field} gauge"]
        lines += [
            f"cluster_home_quota_{field}{{user={json.dumps(user)}}} {values[field]}"
            for user, values in sorted(quotas.items())
        ]
    lines += [
        "# HELP cluster_home_quota_collected_timestamp_seconds When the quotas were last read.",
        "# TYPE cluster_home_quota_collected_timestamp_seconds gauge",
        f"cluster_home_quota_collected_timestamp_seconds {collected}",
    ]
    return "\n".join(lines) + "\n"


def publish(path: Path, content: str) -> None:
    """Replace complete output only after a successful quota read."""
    temporary = path.with_name("." + path.name + ".tmp")
    with temporary.open("w", encoding="utf-8") as stream:
        stream.write(content)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.chmod(0o644)
    temporary.replace(path)


def usage_box(path: Path, uid: int, used: int, notice: int, hard: int) -> None:
    """Publish one private usage box of this machine's own /home, owned by its user, with an atomic rename."""
    lines = [
        f"Home usage on this machine: {used / 1024**3:.2f} GB / {hard / 1024**3:.2f} GB limit.",
        f"Notice threshold: {notice / 1024**3:.2f} GB.",
    ]
    if used >= notice:
        lines.append("Notice: home usage is at or above the notice threshold.")
    if used >= hard:
        lines.extend(
            ["This /home is over its limit: remove files you do not need.",
             "Your jobs use the shared /home and are not held."]
        )  # fmt: skip
    width = max(len(line) for line in lines)
    border = "+" + "-" * (width + 2) + "+"
    content = "\n".join([border, *["| " + line.ljust(width) + " |" for line in lines], border]) + "\n"
    descriptor, temporary_name = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(content)
        stream.flush()
        os.fchown(stream.fileno(), uid, -1)
        os.fchmod(stream.fileno(), 0o400)
        os.fsync(stream.fileno())
    Path(temporary_name).replace(path)


def publish_boxes(folder: Path, quotas: dict[str, dict[str, int]]) -> None:
    """Write every named user's box, then remove the boxes of users no longer named."""
    for user, values in quotas.items():
        usage_box(folder / user, pwd.getpwnam(user).pw_uid, values["used_bytes"], values["soft_bytes"],
                  values["hard_bytes"])  # fmt: skip
    for old in folder.iterdir():
        if old.name not in quotas:
            old.unlink()


def main() -> None:
    """Read fixed operator supplied paths and user names."""
    parser = argparse.ArgumentParser(description=__doc__)
    where = parser.add_mutually_exclusive_group(required=True)
    where.add_argument("--output", type=Path)
    where.add_argument("--notice-dir", type=Path)
    parser.add_argument("--repquota", required=True)
    parser.add_argument("--filesystem", required=True)
    parser.add_argument("--soft-bytes", type=int, required=True)
    parser.add_argument("--hard-bytes", type=int, required=True)
    parser.add_argument("--users", nargs="+", required=True)
    arguments = parser.parse_args()
    quotas = collect(
        arguments.repquota, arguments.filesystem, arguments.users, arguments.soft_bytes, arguments.hard_bytes
    )
    if arguments.output is not None:
        publish(arguments.output, metrics(quotas, time.time()))
    else:
        publish_boxes(arguments.notice_dir, quotas)


if __name__ == "__main__":
    main()
