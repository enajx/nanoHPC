#!/usr/bin/env python3
"""Post cluster-user-check findings to Slack from Prometheus.

Tunnel events are posted once. Findings that persist are posted when first seen
and once a day thereafter. State is saved after each accepted post so a later
failure does not repeat an accepted channel post or private message. A bot token
and user Slack ID enable private messages for lasting user findings.
"""

import argparse
import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import quote
from urllib.request import Request, urlopen

LASTING = {
    "outside-job": ("processes running outside a Slurm job", "Work on compute machines runs only as Slurm jobs."),
    "port": (
        "a listening port",
        "Servers such as Jupyter belong inside a job, protected by a token or password.",
    ),
    "schedule": (
        "a scheduled task or service of their own",
        "Run work as Slurm jobs instead of crontabs, lingering, or user services.",
    ),
    "vscode-server": ("a VS Code server running", "VS Code belongs inside a job: see the interactive notebook guide."),
}


def findings(prometheus: str) -> list[dict[str, str]]:
    """Read active findings from the front node's Prometheus instant query."""
    url = f"{prometheus.rstrip('/')}/api/v1/query?query={quote('cluster_user_check_finding')}"
    with urlopen(url, timeout=20) as response:
        answer = json.loads(response.read().decode())
    if answer["status"] != "success" or answer["data"]["resultType"] != "vector":
        raise RuntimeError(f"Prometheus answered {answer}")
    result: list[dict[str, str]] = []
    for series in answer["data"]["result"]:
        metric = series["metric"]
        # Prometheus omits labels with empty values. The exporter uses host and
        # slurm_job because Prometheus gives job and instance their own meaning.
        item = {key: metric.get(key, "") for key in ("id", "kind", "user", "program", "action", "detail")}
        item.update(machine=metric.get("host", ""), job=metric.get("slurm_job", ""))
        if not item["id"]:
            raise ValueError("Prometheus finding has no id label")
        result.append(item)
    return sorted(result, key=lambda item: item["id"])


def mention(user: str, slack_ids: dict[str, str]) -> str:
    """Show a Slack mention when an account has a configured member ID."""
    return f"<@{slack_ids[user]}> ({user})" if slack_ids.get(user) else f"*{user}*"


def message(item: dict[str, str], slack_ids: dict[str, str], reminder: bool) -> str:
    """Describe one finding in the channel with the matching cluster rule."""
    where = item["machine"] + (f" (job {item['job']})" if item["job"] else "")
    if item["action"] == "stopped":
        return (
            f":no_entry: {mention(item['user'], slack_ids)}'s `{item['program']}` on {where} was stopped: "
            "tunnels are not allowed on the cluster. If this use is acceptable, please ask the admins to allow it."
        )
    if item["action"] == "reported":
        return (
            f":eyes: Admin {mention(item['user'], slack_ids)}'s `{item['program']}` on {where} is a tunnel; "
            "it was reported, not stopped."
        )
    if item["action"] != "lasting":
        raise ValueError(f"unknown finding action: {item['action']}")
    again = "Reminder: " if reminder else ""
    if item["kind"] == "disk":
        return f":floppy_disk: {again}*{item['machine']}*: {item['detail']}."
    what, rule = LASTING[item["kind"]]
    detail = f": {item['detail']}" if item["detail"] else ""
    return f":mag: {again}{mention(item['user'], slack_ids)} has {what} on {where}{detail}. {rule}"


def post(webhook_file: Path, body: str) -> None:
    """Post to Slack; a response other than HTTP 200 with body `ok` fails."""
    request = Request(
        webhook_file.read_text().strip(),
        data=json.dumps({"text": body}).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urlopen(request, timeout=20) as response:
        answer = response.read().decode()
        if response.status != 200 or answer != "ok":
            raise RuntimeError(f"Slack answered {response.status}: {answer}")


def private_message(item: dict[str, str]) -> str:
    """Explain a lasting user finding in a private message."""
    what, rule = LASTING[item["kind"]]
    detail = f" ({item['detail']})" if item["detail"] else ""
    return (
        f"Hi {item['user']}! :wave: The cluster's check noticed {what.replace('their own', 'your own')} "
        f"on {item['machine']}{detail}. {rule} Could you have a look? If you're not sure whether this is OK, "
        "just check in with the admins. Thanks! :pray:"
    )


def send_private(api: str, token: str, slack_id: str, body: str) -> None:
    """Send a private Slack message, failing on an API rejection."""
    request = Request(
        f"{api.rstrip('/')}/chat.postMessage",
        data=json.dumps({"channel": slack_id, "text": body}).encode(),
        headers={"Content-Type": "application/json; charset=utf-8", "Authorization": f"Bearer {token}"},
        method="POST",
    )
    with urlopen(request, timeout=20) as response:
        answer = json.load(response)
    if not answer.get("ok"):
        raise RuntimeError(f"Slack refused the private message: {answer.get('error')}")


def save(state_file: Path, state: dict) -> None:
    """Replace state only after a successful post, avoiding a half-written file."""
    state_file.parent.mkdir(parents=True, exist_ok=True)
    temporary = state_file.with_name(state_file.name + ".tmp")
    temporary.write_text(json.dumps(state, indent=1) + "\n")
    os.replace(temporary, state_file)


def notify(
    prometheus: str,
    webhook_file: Path,
    state_file: Path,
    now: datetime,
    slack_ids: dict[str, str],
    token_file: Path | None,
    slack_api: str,
) -> None:
    """Post channel and optional private notices, tracking each delivery separately."""
    active = findings(prometheus)
    state = json.loads(state_file.read_text()) if state_file.is_file() else {"posted": {}}
    posted = state.setdefault("posted", {})
    private_posted = state.setdefault("private_posted", {})
    present: set[str] = set()
    for item in active:
        identity = item["id"]
        present.add(identity)
        last = posted.get(identity)
        if last is None or (item["action"] == "lasting" and now - datetime.fromisoformat(last) >= timedelta(days=1)):
            post(webhook_file, message(item, slack_ids, last is not None))
            posted[identity] = now.isoformat()
            save(state_file, state)
        user = item["user"]
        if item["action"] != "lasting" or item["kind"] == "disk" or not slack_ids.get(user) or token_file is None:
            continue
        private_last = private_posted.get(identity)
        if private_last is not None and now - datetime.fromisoformat(private_last) < timedelta(days=1):
            continue
        send_private(slack_api, token_file.read_text().strip(), slack_ids[user], private_message(item))
        private_posted[identity] = now.isoformat()
        save(state_file, state)
    # Once absent for a day, a later recurrence is a new finding.
    retained = {}
    for kind in ("posted", "private_posted"):
        retained[kind] = {
            identity: when
            for identity, when in state[kind].items()
            if identity in present or now - datetime.fromisoformat(when) < timedelta(days=1)
        }
    if retained["posted"] != posted or retained["private_posted"] != private_posted:
        state.update(retained)
        save(state_file, state)


def main() -> None:
    """Parse the timer command line and run one notification pass."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prometheus", required=True)
    parser.add_argument("--webhook-file", required=True, type=Path)
    parser.add_argument("--state", required=True, type=Path)
    parser.add_argument("--bot-token-file", type=Path, help="optional Slack bot token for private messages")
    parser.add_argument("--slack-api", default="https://slack.com/api")
    parser.add_argument("--now", required=True, help="ISO timestamp or 'now'")
    parser.add_argument(
        "--user",
        action="append",
        default=[],
        metavar="NAME:SLACK_ID",
        help="optional Slack member ID for a channel mention",
    )
    args = parser.parse_args()
    slack_ids = dict(user.split(":", 1) for user in args.user)
    now = datetime.now(timezone.utc) if args.now == "now" else datetime.fromisoformat(args.now)  # noqa: UP017 (Python 3.10)
    if now.tzinfo is None:
        parser.error("--now needs a timezone")
    notify(args.prometheus, args.webhook_file, args.state, now, slack_ids, args.bot_token_file, args.slack_api)


if __name__ == "__main__":
    main()
