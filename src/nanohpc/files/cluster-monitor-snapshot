#!/usr/bin/python3
"""Publish a fixed read-only view of Slurm or directly used monitor machines.

In Slurm mode, read scheduler commands and optional Prometheus measurements. In monitor mode, read
Prometheus alone. Never execute visitor-supplied queries. Write:
- status.json for the website (`--output`, and a copy at `--mirror-output`);
- machines.md, a Markdown table of the compute machines (`--machine-markdown-output`, and a copy at
  `--machine-markdown-mirror-output`);
- cluster.prom, snapshot and mode-specific figures for node_exporter's textfile collector (`--metrics`).
Every file is replaced whole, and only after all reads succeed: any failure leaves the last good files.

Arguments (all set by the operator, never from the website):
  --mode slurm|monitor      Slurm is the default for existing deployments.
  --output PATH              status.json to write.
  --mirror-output PATH       optional second copy of status.json.
  --machine-markdown-output PATH         machines.md to write.
  --machine-markdown-mirror-output PATH  optional second copy of machines.md.
  --metrics PATH             cluster.prom to write.
  --controller NAME          the front node's machine name in Slurm mode, the monitor host otherwise.
  --cluster-name NAME        the cluster's name, for the machines.md heading.
  --machines PATH            JSON file of every machine to check, by machine name (Prometheus's `machine`
                             label, and Slurm's node name for compute machines):
                               {"NAME": {"role": "front" | "compute" | "storage",
                                         "units": ["slurmd.service", ...],
                                         "mounts": ["/", "/home", "/scratch", ...],
                                         "building": "optional area name"}}
                             In monitor mode, roles are "monitor" and "machine", and exactly the controller
                             machine has the monitor role. `building` applies to Slurm mode only. `units` are
                             the systemd units that must be active and `mounts` the mount points that must be
                             writable with free space. In Slurm mode, exactly one machine has the role front
                             (the --controller); the compute machines must be exactly Slurm's nodes; storage
                             machines (home and backup machines) run no Slurm and get no Slurm check.
  --refresh-seconds N        how often the snapshot is refreshed (at least 5), published for the website.
  --accounting-start TIME    Slurm mode: start of the GPU-hour totals, as sacct reads it: YYYY-MM-DD or
                             YYYY-MM-DDTHH:MM:SS, local time, no timezone.
  --prometheus-url URL       Prometheus (for example http://127.0.0.1:9090); required in monitor mode.
                             Without it in Slurm mode,
                             every machine's health is Unknown and no home quotas are shown. Home quotas
                             come from the cluster_home_quota_* series that cluster-home-quotas writes on the
                             home machine; they are left out when absent or older than 10 minutes, and series
                             from more than one machine are an error.
  --users NAME [NAME ...]    Slurm mode: required cluster users for rankings and cards. Monitor mode: optional
                             login names for the website.
  --exclude-users NAME [...] Slurm mode: test accounts omitted from rankings, cards, and per-user metrics.
"""

import argparse
import json
import os
import re
import subprocess
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

from cluster_machine_status import (
    apply_maintenance,
    machine_status,
    maintenance_reason,
    measurements,
    monitor_machine_status,
