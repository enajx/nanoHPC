# Managed by nanoHPC. sshd reads root's keys only from this file (local disk, so it works without /home).
# The administrators in cluster.yml may log in as root from anywhere, with a key only.
{% for user in users if user.name in admins %}
# {{ user.name }}
{% for key in user.ssh_keys %}
{{ key }}
{% endfor %}
{% endfor %}
{% if auto_deploy_key %}
# The front node's automatic deploys, accepted only from its address.
from="{{ front_address }}",no-agent-forwarding,no-X11-forwarding {{ auto_deploy_key }}
{% endif %}
{% if agent_runner_key | default('') %}
# The Slack agent's runner (on the front node): read-only checks, and changes an approver asked for or approved.
from="{{ front_address }}",no-agent-forwarding,no-port-forwarding,no-X11-forwarding {{ agent_runner_key }}
{% endif %}
{% if login_copy_key | default('') %}
# The front node's copies of the login banner's data (this is a login node): only that receiving command.
from="{{ front_address }}",command="/usr/local/sbin/nanohpc-login-copy-receive",restrict {{ login_copy_key }}
{% endif %}
{% if home_copy_key | default('') %}
# The home machine's nightly copy of each user's listed files (this machine keeps its own /home): only that receiving
# command, which writes as the user into their own home folder.
from="{{ home_address }}",command="/usr/local/sbin/nanohpc-home-copy-receive",restrict {{ home_copy_key }}
{% endif %}
