# nanoHPC website (generated by nanoHPC; changes here are overwritten by the next deploy).
# Port 80: Let's Encrypt's challenge files, and a redirect to HTTPS for everything else.
# Port 443: the website under {{ website.path }}, read-only (GET only, except Grafana's query endpoint),
# and Grafana under {{ website.path }}grafana/ limited to the six dashboards and the API calls they need.
{% set prefix = website.path %}
{# With an allow list, the front node itself (its health checks) may always open the site. #}
{% set allowed = (['127.0.0.1', '::1'] + website.allow) if website.allow else [] %}
{% set escaped = website.path | regex_escape %}
{% set dashboards = 'nanohpc-overview|nanohpc-machines|nanohpc-usage|nanohpc-history|nanohpc-queue|nanohpc-queue-history' %}
{% set headers %}
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; frame-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
{% endset %}
{# Inside the Grafana block (which denies everything else), who may use the allowed routes. #}
{% set grafana_access %}
{% for network in allowed %}
            allow {{ network }};
{% endfor %}
            {{ 'deny all;' if website.allow else 'allow all;' }}
{% endset %}
{% set grafana %}
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-WEBAUTH-USER "";
        proxy_set_header X-Grafana-Org-Id "1";
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
        client_max_body_size 128k;
        limit_conn nanohpc_connections 32;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
{% endset %}

limit_req_zone $binary_remote_addr zone=nanohpc_queries:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=nanohpc_connections:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        limit_except GET { deny all; }
        root /var/lib/nanohpc/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://{{ website.hostname }}$request_uri;
    }
}

{% if tls_certificate is not none %}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name {{ website.hostname }};
    server_tokens off;
    absolute_redirect off;
    access_log off;

    ssl_certificate {{ tls_certificate }};
    ssl_certificate_key {{ tls_certificate_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

{% if website.forwarded_by %}
    # The lab's web server forwards visitors here; only from it is the visitor address it passes on trusted.
    set_real_ip_from {{ website.forwarded_by }};
    real_ip_header X-Forwarded-For;
{% endif %}
{% if website.allow %}
    # Only these networks may open the website (cluster.website.allow), and the front node itself.
{% for network in allowed %}
    allow {{ network }};
{% endfor %}
    deny all;
{% endif %}

{% if prefix != '/' %}
    location = {{ prefix[:-1] }} { return 301 {{ prefix }}; }
    location = / { return 302 {{ prefix }}; }
{% endif %}

    location = {{ prefix }}site.json {
        limit_except GET { deny all; }
        alias /srv/nanohpc-web/config/site.json;
        add_header Cache-Control "no-store" always;
{{ headers }}    }

{# Exact locations: the site's `^~` prefix location below would hide regex locations. The built docs.md
   and policy.md are templates; these serve the filled copies. #}
{% for page in ['docs.md', 'policy.md'] %}
    location = {{ prefix }}{{ page }} {
        limit_except GET { deny all; }
        alias /srv/nanohpc-web/config/{{ page }};
        default_type text/markdown;
        add_header Cache-Control "no-store" always;
{{ headers }}    }

{% endfor %}
{% if website.logo %}
    location = {{ prefix }}{{ website.logo.name }} {
        limit_except GET { deny all; }
        alias /srv/nanohpc-web/config/{{ website.logo.name }};
{{ headers }}    }

{% endif %}
    location = {{ prefix }}machines.md {
        limit_except GET { deny all; }
        alias /var/lib/nanohpc/monitor/machines.md;
        default_type text/markdown;
        add_header Cache-Control "no-store" always;
{{ headers }}    }

{% if website.deploy_hook %}
    # GitHub's push notifications for automatic deploys (checked by the listener with the shared secret).
    location = {{ prefix }}deploy-hook {
        allow all;
        limit_except POST { deny all; }
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:9099;
        proxy_set_header Host $host;
    }

{% endif %}
    location = {{ prefix }}data/status.json {
        limit_except GET { deny all; }
        alias /var/lib/nanohpc/monitor/status.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ {{ prefix }}grafana/ {
        deny all;

        location ~ ^{{ escaped }}grafana/(public/|d/({{ dashboards }})(/|$)) {
{{ grafana_access }}            limit_except GET { deny all; }
{{ grafana }}        }

        location ~ ^{{ escaped }}grafana/api/(frontend/settings|dashboards/uid/({{ dashboards }})|datasources/uid/(cluster-detail|cluster-history)|plugins/prometheus/settings|annotations|folders/[a-zA-Z0-9_-]+|prometheus/grafana/api/v1/rules|user|org|access-control/user/permissions)$ {
{{ grafana_access }}            limit_except GET { deny all; }
{{ grafana }}        }

        location ~ ^{{ escaped }}grafana/apis/dashboard\.grafana\.app/((v2/namespaces/default/dashboards/({{ dashboards }})/dto)?)$ {
{{ grafana_access }}            limit_except GET { deny all; }
{{ grafana }}        }

        location = {{ prefix }}grafana/api/ds/query {
{{ grafana_access }}            limit_except POST { deny all; }
            limit_req zone=nanohpc_queries burst=20 nodelay;
{{ grafana }}        }

        # Browser telemetry is discarded, not forwarded as an extra writable API.
        location = {{ prefix }}grafana/api/frontend-metrics { return 204; }
    }

    # The page names its build's files, so browsers must ask for it again after an upgrade.
    location = {{ prefix }}index.html {
        limit_except GET { deny all; }
        alias /srv/nanohpc-web/current/index.html;
        add_header Cache-Control "no-cache" always;
{{ headers }}    }

    location ^~ {{ prefix }} {
        limit_except GET { deny all; }
        alias /srv/nanohpc-web/current/;
        index index.html;
{{ headers }}    }
{% if prefix != '/' %}

    location / { return 404; }
{% endif %}
}
{% endif %}
