// Managed by nanoHPC. A confirmed nanohpc update enables automatic security installs on this machine.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "{{ '1' if security_updates_marker.stat.exists else '0' }}";

// Clear the Ubuntu defaults, which may also include the normal updates pocket.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
};

// Driver and CUDA changes require a confirmed nanohpc update.
Unattended-Upgrade::Package-Blacklist {
    "^.*(nvidia|cuda).*";
};
Unattended-Upgrade::Automatic-Reboot "false";
